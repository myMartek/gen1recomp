# Generated from a user-provided Pokemon Red ROM.
# Regenerate with: python3 tools/build_data.py --rom /path/to/pokemon-red.gb --clean
data/generated/
assets/generated/

# LÖVE packages
*.love

# Local saves (LÖVE writes to its save dir, but keep the repo clean anyway)
save/

__pycache__/
*.pyc
.venv
.*/
.*
!.github/
!.gitignore
!.luacheckrc

# Android build outputs / local SDK path / packaged payload (keep love-android sources)
mobile/android/app/build/
mobile/android/love/build/
mobile/android/.gradle/
mobile/android/local.properties
mobile/android/app/src/embed/assets/game.love
mobile/android/**/build/

# iOS love-src (downloaded love-*-ios-source; see mobile/ios/README.md)
mobile/ios/love-src/
mobile/ios/cache/
mobile/ios/build/

# Final packaged build artifacts (mac/win/web/android/ios) — see scripts/build.sh
/dist/

# Legacy manual convenience-copy location (superseded by /dist/android/)
mobile/dist/

# Tiled map-editing workspace (tools/tiled_export.py). Derived from the imported
# ROM cache exactly like data/generated/, so it is never committable.
/build/tiled/

# per-machine iOS bundle-id pin (see scripts/build_ios.sh)
mobile/ios/bundle_id.local

# visionOS love-src (fetched by scripts/build_visionos.sh --fetch)
mobile/visionos/love-src/
mobile/visionos/cache/
mobile/visionos/build/

# xros dependency slices built by mobile/visionos/deps/build_deps.sh (LuaJIT,
# openal-soft, SDL3, FreeType, HarfBuzz, ogg, vorbis). Built, never committed:
# love-apple-dependencies ships no xros slices, and committing third-party
# binaries would pull in a THIRD_PARTY_NOTICES obligation for each one.
# The builder and its patches DO belong in the repo, hence the narrow rules.
mobile/visionos/deps/*.xcframework/
mobile/visionos/deps/src/
mobile/visionos/deps/build/
mobile/visionos/deps/include/

# XcodeGen output — regenerated from mobile/visionos/project.yml on every build
mobile/visionos/*.xcodeproj/

# packaged payload
mobile/visionos/resources/game.love

# per-machine visionOS bundle-id pin (mirrors mobile/ios/bundle_id.local)
mobile/visionos/bundle_id.local

# Never. Bring your own legally-obtained cartridge dump; nothing derived from
# cartridge bytes is committable. data/generated/ + assets/generated/ above
# cover the decoded cache, these cover the raw dump itself.
*.gb
*.gbc
*.sav
*.sgm
mobile/visionos/team.local

# Translation worksheets. modkit writes the English behind every key into
# these so an author has something to translate FROM -- which makes them
# extracted ROM text, exactly like data/generated/. The mod beside them holds
# only keys and the translator's own words and is committable; this is not.
mods/*-worksheet/

# A translation's glyph sheet is cut from a cartridge, like data/generated/.
# The catalogs beside it are cartridge text for the same reason; only the
# scaffold's keys, lang/font.lua, lang/charmap.lua and the engine-string
# translation are ours to commit.
mods/*/assets/font/*.png

# CARTRIDGE-DERIVED TRANSLATION DATA -- never in this repository.
#
# This tree is public. The catalogs below are lifted out of a commercial
# cartridge with tools/de_*_from_rom.py and are not ours to publish; the German
# text that IS ours (lang/strings.lua, 185 lines the engine writes itself) is
# committed and deliberately not listed here.
#
# They are generated on demand and, for the shipping build, kept in the private
# wrapper repository under translations/ -- see its translations/README.md. A
# `git add -A` in a tree that happens to have them lying around must not be the
# thing that publishes them.
mods/*/lang/dialogue.lua
mods/*/lang/species_names.lua
mods/*/lang/move_names.lua
mods/*/lang/item_names.lua
mods/*/lang/trainer_names.lua
mods/*/lang/status_labels.lua
mods/*/assets/font/*.png
mods/*/lang/strings_rom.lua

# GENERATED, and one of them carries cartridge content.
#
# bin/prepare.sh in the wrapper stages the mods into here and zips them, and
# the German zip has the catalogs overlaid from the wrapper's private
# translations/. Committing this directory would publish exactly what the
# entries above exist to keep out, in a form no reviewer would think to look
# inside.
assets/bundled-mods/
