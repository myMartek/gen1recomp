# Generated from a user-provided Pokemon Red ROM.
# Regenerate with: python3 tools/build_data.py --rom /path/to/pokemon-red.gb --clean
data/generated/
assets/generated/

# LÖVE packages
*.love

# Local saves (LÖVE writes to its save dir, but keep the repo clean anyway)
save/

__pycache__/
*.pyc
.venv
.*/
.*
!.github/
!.gitignore
!.luacheckrc

# Android build outputs / local SDK path / packaged payload (keep love-android sources)
mobile/android/app/build/
mobile/android/love/build/
mobile/android/.gradle/
mobile/android/local.properties
mobile/android/app/src/embed/assets/game.love
mobile/android/**/build/

# iOS love-src (downloaded love-*-ios-source; see mobile/ios/README.md)
mobile/ios/love-src/
mobile/ios/cache/
mobile/ios/build/

# Final packaged build artifacts (mac/win/web/android/ios) — see scripts/build.sh
/dist/

# Legacy manual convenience-copy location (superseded by /dist/android/)
mobile/dist/

# Tiled map-editing workspace (tools/tiled_export.py). Derived from the imported
# ROM cache exactly like data/generated/, so it is never committable.
/build/tiled/

# per-machine iOS bundle-id pin (see scripts/build_ios.sh)
mobile/ios/bundle_id.local

# visionOS love-src (fetched by scripts/build_visionos.sh --fetch)
mobile/visionos/love-src/
mobile/visionos/cache/
mobile/visionos/build/

# xros dependency slices built by scripts/build_visionos.sh --deps (LuaJIT,
# openal-soft, SDL3, FreeType, HarfBuzz, ogg, vorbis). Built, never committed:
# love-apple-dependencies ships no xros slices, and committing third-party
# binaries would pull in a THIRD_PARTY_NOTICES obligation for each one.
mobile/visionos/deps/

# XcodeGen output — regenerated from mobile/visionos/project.yml on every build
mobile/visionos/*.xcodeproj/

# packaged payload
mobile/visionos/resources/game.love

# per-machine visionOS bundle-id pin (mirrors mobile/ios/bundle_id.local)
mobile/visionos/bundle_id.local

# Never. Bring your own legally-obtained cartridge dump; nothing derived from
# cartridge bytes is committable. data/generated/ + assets/generated/ above
# cover the decoded cache, these cover the raw dump itself.
*.gb
*.gbc
*.sav
*.sgm
