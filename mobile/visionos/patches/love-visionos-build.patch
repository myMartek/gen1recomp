--- /dev/null
+++ b/src/modules/xr/wrap_XR.mm
@@ -0,0 +1,1555 @@
+/**
+ * love.xr -- CompositorServices and ARKit, for visionOS.
+ *
+ * This exists so a Lua renderer can draw a stereo frame: ask for a frame, read
+ * one camera per eye, draw into the drawable textures, submit. The voxel mod
+ * already renders per eye for OpenXR on Windows; this is the same shape with a
+ * different backend underneath.
+ *
+ * Two deliberate decisions:
+ *
+ * It is a plain table of functions, not a love Module. A Module would need an
+ * entry in Module::ModuleType, which is a header every part of LOVE includes --
+ * a much larger patch for nothing, since nothing here needs module lifecycle.
+ *
+ * LUA DRIVES THE FRAME LOOP. beginFrame() blocks until the compositor is ready
+ * and returns the pose for the frame being submitted. The alternative -- a
+ * render loop in the host calling into Lua -- would leave LOVE rendering with
+ * whatever head pose it happened to have, and by submission that pose is
+ * already stale. Everything about the timing here follows from that.
+ *
+ * Nothing that crosses into Lua is a pointer: poses and angles come back as
+ * plain tables, matching the discipline lib/VRXR.lua already keeps for OpenXR.
+ */
+
+#include "common/config.h"
+
+#ifdef LOVE_VISIONOS
+
+#include "wrap_XR.h"
+
+#include <cstdio>   // TEMPORARY: lifecycle logging, see the [xr] prints below
+#include <atomic>
+#include <unistd.h>
+
+#include "common/runtime.h"
+#include "common/Exception.h"
+#include "graphics/Graphics.h"
+#include "graphics/Texture.h"
+#include "graphics/wrap_Texture.h"
+#include "graphics/metal/Graphics.h"
+#include "graphics/metal/Texture.h"
+
+#import <ARKit/ARKit.h>
+#import <CompositorServices/CompositorServices.h>
+#import <Metal/Metal.h>
+#import <simd/simd.h>
+
+namespace love
+{
+namespace xr
+{
+
+// ---------------------------------------------------------------- state
+// One frame in flight at a time, which is what the Lua side can express: it
+// calls beginFrame, draws, then submitFrame. Holding these here rather than
+// handing opaque values to Lua keeps cdata out of the mod entirely.
+// Under Objective-C++ this SDK handle is an NSObject pointer, so ARC keeps the
+// global and each local copy strong while the compositor thread winds down.
+static cp_layer_renderer_t g_layer = nullptr;
+static ar_session_t g_arSession = nullptr;
+static ar_world_tracking_provider_t g_worldTracking = nullptr;
+static ar_hand_tracking_provider_t g_handTracking = nullptr;
+// Reused across frames: get_latest_anchors FILLS anchors you hand it rather
+// than returning new ones, so allocating a pair per frame would be waste.
+static ar_hand_anchor_t g_handAnchors[2] = { nullptr, nullptr };
+
+// Set while Lua owns the frame loop. The host's own renderer polls this and
+// stands down: two loops calling cp_frame_* on one layer would be a race, and
+// the host keeps drawing until the mod actually turns VR on.
+static std::atomic<bool> g_claimed(false);
+// True from immediately before the Swift fallback asks for a frame until it
+// has either presented or abandoned it. claim() waits this out before Lua
+// touches the same cp_layer_renderer_t.
+static std::atomic<bool> g_hostFrameActive(false);
+
+static cp_frame_t g_frame = nullptr;
+static cp_drawable_t g_drawable = nullptr;
+// Linear eye images rendered by LÖVE. The final native Metal pass maps these
+// into the compositor's foveated physical textures.
+static id<MTLTexture> g_eyeSources[2] = { nil, nil };
+static love::graphics::Texture *g_eyeRenderColors[2] = { nullptr, nullptr };
+static love::graphics::Texture *g_eyeRenderDepths[2] = { nullptr, nullptr };
+// Linear, physical-resolution snapshots used only by screen-space effects
+// such as water. They cover the whole logical eye in ordinary 0..1 UVs.
+static love::graphics::Texture *g_eyeResolvedColors[2] = { nullptr, nullptr };
+static love::graphics::Texture *g_eyeResolvedDepths[2] = { nullptr, nullptr };
+static love::graphics::Texture *g_eyeRateLookups[2] = { nullptr, nullptr };
+static simd_float4x4 g_originFromDevice = matrix_identity_float4x4;
+
+// ARKit world -> the space VRRig actually speaks.
+//
+// lib/VRRig.lua is written against OpenXR's LOCAL space: metres, +Y up, and
+// crucially an origin AT THE HEAD as it was at session start, because an
+// OpenXR runtime recentres there. ARKit does not. It hands out absolute world
+// coordinates whose origin sat on the floor and wherever the session began,
+// and the measured head came back at y = 1.03 m.
+//
+// Everything the rig places is then displaced by that: the diorama is anchored
+// 0.95 m from an origin it believes is the head, so with a metre of unexpected
+// height the anchor lands below the floor and the world is not where the
+// player is looking.
+//
+// So the bridge owns the correction, exactly as the port's plan called for and
+// as VRXR gets for free from its runtime: capture the first tracked device
+// pose, and emit every later pose relative to it. Y is deliberately NOT
+// cancelled in the rotation-free part -- see below.
+static bool g_haveRig = false;
+static simd_float4x4 g_rigFromOrigin = matrix_identity_float4x4;
+
+static void updateRigFromOrigin(simd_float4x4 originFromDevice)
+{
+	if (g_haveRig)
+		return;
+
+	simd_float4 p = originFromDevice.columns[3];
+	// Yaw only. Pitch and roll of the head at start are accidents of how
+	// someone happened to be looking; baking them in would tilt the world.
+	// -Z is forward, so this is the heading the player faced.
+	// Extract the Ry angle from the device's +Z basis. rot below applies its
+	// negative, so rot * originFromDevice has identity yaw on the first frame.
+	// The old pair negated both components, which makes an identity pose report
+	// pi instead of zero and recentres the whole world backwards -- notably
+	// exposing the mirrored back of signs.
+	float yaw = atan2f(originFromDevice.columns[2].x,
+					   originFromDevice.columns[2].z);
+
+	// The inverse of T(x, y, z) . Ry(yaw), built directly. The translation
+	// includes Y: the rig wants the head at the origin, and leaving the real
+	// standing height in is precisely what displaced everything.
+	float c = cosf(-yaw), sn = sinf(-yaw);
+	simd_float4x4 rot = matrix_identity_float4x4;
+	rot.columns[0] = (simd_float4){  c, 0, -sn, 0 };
+	rot.columns[2] = (simd_float4){ sn, 0,   c, 0 };
+
+	simd_float4x4 trn = matrix_identity_float4x4;
+	trn.columns[3] = (simd_float4){ -p.x, -p.y, -p.z, 1 };
+
+	g_rigFromOrigin = simd_mul(rot, trn);
+	g_haveRig = true;
+
+	printf("[xr] rig origin captured: head was %.2f,%.2f,%.2f yaw %.1f deg\n",
+		   p.x, p.y, p.z, yaw * 57.2957795f);
+	fflush(stdout);
+}
+
+// A love Texture per drawable texture, kept alive across frames. The
+// compositor recycles a small ring of drawables, so this settles at a handful
+// of entries rather than allocating one per frame -- and the mod's own canvas
+// caches key off the object, so handing it a new one each frame would make it
+// rebuild everything sixty times a second.
+static std::map<void *, love::graphics::Texture *> g_eyeTextures;
+
+static love::graphics::metal::Graphics *getMetalGraphics()
+{
+	auto gfx = Module::getInstance<love::graphics::Graphics>(Module::M_GRAPHICS);
+	return dynamic_cast<love::graphics::metal::Graphics *>(gfx);
+}
+
+static void releaseEyeRenderTargets()
+{
+	for (int i = 0; i < 2; i++)
+	{
+		if (g_eyeRenderColors[i] != nullptr)
+			g_eyeRenderColors[i]->release();
+		if (g_eyeRenderDepths[i] != nullptr)
+			g_eyeRenderDepths[i]->release();
+		if (g_eyeResolvedColors[i] != nullptr)
+			g_eyeResolvedColors[i]->release();
+		if (g_eyeResolvedDepths[i] != nullptr)
+			g_eyeResolvedDepths[i]->release();
+		if (g_eyeRateLookups[i] != nullptr)
+			g_eyeRateLookups[i]->release();
+		g_eyeRenderColors[i] = nullptr;
+		g_eyeRenderDepths[i] = nullptr;
+		g_eyeResolvedColors[i] = nullptr;
+		g_eyeResolvedDepths[i] = nullptr;
+		g_eyeRateLookups[i] = nullptr;
+	}
+}
+
+static bool ensureEyeRenderTargets(int index)
+{
+	if (g_drawable == nullptr || index < 0 || index >= 2)
+		return false;
+	auto gfx = getMetalGraphics();
+	if (gfx == nullptr)
+		return false;
+
+	id<MTLTexture> drawableColor = cp_drawable_get_color_texture(g_drawable, index);
+	size_t mapCount = cp_drawable_get_rasterization_rate_map_count(g_drawable);
+	id<MTLRasterizationRateMap> map = index < (int) mapCount
+		? cp_drawable_get_flipped_rasterization_rate_map(g_drawable, index) : nil;
+	if (drawableColor == nil || map == nil)
+		return false;
+	MTLSize screen = map.screenSize;
+
+	bool matches = g_eyeRenderColors[index] != nullptr
+		&& g_eyeRenderDepths[index] != nullptr
+		&& g_eyeRenderColors[index]->getPixelWidth() == (int) screen.width
+		&& g_eyeRenderColors[index]->getPixelHeight() == (int) screen.height;
+	if (matches)
+	{
+		id<MTLTexture> existing = (__bridge id<MTLTexture>)
+			(void *) g_eyeRenderColors[index]->getHandle();
+		matches = existing.width == drawableColor.width
+			&& existing.height == drawableColor.height;
+	}
+
+	if (!matches)
+	{
+		if (g_eyeRenderColors[index] != nullptr)
+			g_eyeRenderColors[index]->release();
+		if (g_eyeRenderDepths[index] != nullptr)
+			g_eyeRenderDepths[index]->release();
+		g_eyeRenderColors[index] = nullptr;
+		g_eyeRenderDepths[index] = nullptr;
+
+		MTLTextureDescriptor *colorDesc = [MTLTextureDescriptor
+			texture2DDescriptorWithPixelFormat:drawableColor.pixelFormat
+			width:drawableColor.width height:drawableColor.height mipmapped:NO];
+		colorDesc.storageMode = MTLStorageModePrivate;
+		colorDesc.usage = MTLTextureUsageRenderTarget | MTLTextureUsageShaderRead;
+		id<MTLTexture> color = [drawableColor.device newTextureWithDescriptor:colorDesc];
+
+		MTLTextureDescriptor *depthDesc = [MTLTextureDescriptor
+			texture2DDescriptorWithPixelFormat:MTLPixelFormatDepth32Float
+			width:drawableColor.width height:drawableColor.height mipmapped:NO];
+		depthDesc.storageMode = MTLStorageModePrivate;
+		depthDesc.usage = MTLTextureUsageRenderTarget | MTLTextureUsageShaderRead;
+		id<MTLTexture> depth = [drawableColor.device newTextureWithDescriptor:depthDesc];
+		if (color == nil || depth == nil)
+			return false;
+
+		g_eyeRenderColors[index] = gfx->newTextureFromHandle(
+			(__bridge void *) color, (int) screen.width, (int) screen.height,
+			(__bridge void *) map);
+		g_eyeRenderDepths[index] = gfx->newTextureFromHandle(
+			(__bridge void *) depth, (int) screen.width, (int) screen.height,
+			(__bridge void *) map);
+	}
+
+	auto color = dynamic_cast<love::graphics::metal::Texture *>(g_eyeRenderColors[index]);
+	auto depth = dynamic_cast<love::graphics::metal::Texture *>(g_eyeRenderDepths[index]);
+	if (color == nullptr || depth == nullptr)
+		return false;
+	color->setRasterizationRateMap(map);
+	depth->setRasterizationRateMap(map);
+	return true;
+}
+
+// A tiny final-pass shader. The scene was already rasterized through the
+// drawable's flipped rate map, so this pass copies the packed physical image
+// into the compositor's regularly-oriented physical texture.
+static id<MTLLibrary> g_foveatedCopyLibrary = nil;
+static std::map<uint64_t, id<MTLRenderPipelineState>> g_foveatedCopyPipelines;
+static std::map<uint64_t, id<MTLRenderPipelineState>> g_foveatedResolvePipelines;
+static id<MTLRenderPipelineState> g_rateLookupPipeline = nil;
+
+static id<MTLRenderPipelineState> foveatedCopyPipeline(id<MTLDevice> device,
+											   MTLPixelFormat colorFormat,
+											   MTLPixelFormat depthFormat)
+{
+	uint64_t key = ((uint64_t) colorFormat << 32) | (uint32_t) depthFormat;
+	auto found = g_foveatedCopyPipelines.find(key);
+	if (found != g_foveatedCopyPipelines.end())
+		return found->second;
+
+	if (g_foveatedCopyLibrary == nil)
+	{
+		NSString *source = @R"metal(
+#include <metal_stdlib>
+using namespace metal;
+struct CopyOut { float4 position [[position]]; float2 uv; };
+vertex CopyOut xr_copy_vertex(uint id [[vertex_id]]) {
+    const float2 positions[3] = { float2(-1,-1), float2(3,-1), float2(-1,3) };
+    float2 p = positions[id];
+    CopyOut out;
+    out.position = float4(p, 0, 1);
+    // The mod's Metal eye is vertically mirrored. With Metal's top-left
+    // viewport, this interpolation turns it over during the final copy.
+    out.uv = (p + 1.0) * 0.5;
+    return out;
+}
+struct CopyUniforms {
+    float2 invPhysical;   // 1 / source physical size
+    float2 screenSize;    // logical eye, both maps share it
+};
+fragment float4 xr_copy_fragment(CopyOut in [[stage_in]],
+                                 texture2d<float> source [[texture(0)]],
+                                 constant rasterization_rate_map_data &destRate [[buffer(0)]],
+                                 constant rasterization_rate_map_data &srcRate [[buffer(1)]],
+                                 constant CopyUniforms &uniforms [[buffer(2)]]) {
+    constexpr sampler linearSampler(filter::linear,
+                                    address::clamp_to_edge);
+    // Through LOGICAL space, not by mirroring the physical row index.
+    //
+    // This used to flip physical Y directly, on the assumption that the
+    // flipped rate map is the exact vertical mirror of the regular one. That
+    // holds for a fixed foveation pattern and not for an eye-tracked one: the
+    // dense region follows the gaze, so mirroring a physical row lands on a
+    // different logical row than mirroring the logical coordinate does. The
+    // error is zero where the two agree -- at the gaze point -- and grows with
+    // distance from it, which is exactly "the middle is right and everything
+    // else is bent around it".
+    //
+    // Decode this destination fragment to logical with the DESTINATION map,
+    // mirror there, then encode back with the SOURCE map. Exact for any pair.
+    rasterization_rate_map_decoder destDecoder(destRate);
+    rasterization_rate_map_decoder srcDecoder(srcRate);
+    float2 logical = destDecoder.map_physical_to_screen_coordinates(in.position.xy);
+    logical.y = uniforms.screenSize.y - logical.y;
+    float2 physical = srcDecoder.map_screen_to_physical_coordinates(logical);
+    return source.sample(linearSampler, physical * uniforms.invPhysical);
+}
+struct ResolveUniforms { float2 screenSize; float2 outputSize; };
+struct ResolveOut {
+    float4 color [[color(0)]];
+    float depth [[color(1)]];
+};
+fragment ResolveOut xr_resolve_fragment(
+        CopyOut in [[stage_in]],
+        texture2d<float> packedColor [[texture(0)]],
+        depth2d<float> packedDepth [[texture(1)]],
+        constant rasterization_rate_map_data &rateData [[buffer(0)]],
+        constant ResolveUniforms &uniforms [[buffer(1)]]) {
+    constexpr sampler colorSampler(coord::pixel, filter::linear,
+                                   address::clamp_to_edge);
+    constexpr sampler depthSampler(coord::pixel, filter::nearest,
+                                   address::clamp_to_edge);
+    rasterization_rate_map_decoder decoder(rateData);
+    // This output is a conventional physical-resolution texture spanning the
+    // whole logical eye. Convert its pixel to logical screen coordinates, then
+    // ask Metal where that point lives in the packed intermediary.
+    float2 logical = in.position.xy * uniforms.screenSize / uniforms.outputSize;
+    float2 physical = decoder.map_screen_to_physical_coordinates(logical);
+    ResolveOut out;
+    out.color = packedColor.sample(colorSampler, physical);
+    out.depth = packedDepth.sample(depthSampler, physical);
+    return out;
+}
+struct RateLookupUniforms {
+    float2 screenSize;
+    float2 physicalSize;
+    float2 outputSize;
+};
+fragment half2 xr_rate_lookup_fragment(
+        CopyOut in [[stage_in]],
+        constant rasterization_rate_map_data &rateData [[buffer(0)]],
+        constant RateLookupUniforms &uniforms [[buffer(1)]]) {
+    rasterization_rate_map_decoder decoder(rateData);
+    float2 logical = in.position.xy * uniforms.screenSize / uniforms.outputSize;
+    float2 physical = decoder.map_screen_to_physical_coordinates(logical);
+    return half2(clamp(physical / uniforms.physicalSize, 0.0, 1.0));
+}
+)metal";
+		NSError *error = nil;
+		g_foveatedCopyLibrary = [device newLibraryWithSource:source
+												 options:nil error:&error];
+		if (g_foveatedCopyLibrary == nil)
+		{
+			printf("[xr] foveated copy shader failed: %s\n",
+				   error.localizedDescription.UTF8String);
+			fflush(stdout);
+			return nil;
+		}
+	}
+
+	MTLRenderPipelineDescriptor *desc = [MTLRenderPipelineDescriptor new];
+	desc.vertexFunction = [g_foveatedCopyLibrary newFunctionWithName:@"xr_copy_vertex"];
+	desc.fragmentFunction = [g_foveatedCopyLibrary newFunctionWithName:@"xr_copy_fragment"];
+	desc.colorAttachments[0].pixelFormat = colorFormat;
+	desc.depthAttachmentPixelFormat = depthFormat;
+	NSError *error = nil;
+	id<MTLRenderPipelineState> pipeline =
+		[device newRenderPipelineStateWithDescriptor:desc error:&error];
+	if (pipeline == nil)
+	{
+		printf("[xr] foveated copy pipeline failed: %s\n",
+			   error.localizedDescription.UTF8String);
+		fflush(stdout);
+		return nil;
+	}
+	g_foveatedCopyPipelines[key] = pipeline;
+	return pipeline;
+}
+
+static id<MTLRenderPipelineState> rateLookupPipeline(id<MTLDevice> device)
+{
+	if (g_rateLookupPipeline != nil)
+		return g_rateLookupPipeline;
+	if (g_foveatedCopyLibrary == nil
+		&& foveatedCopyPipeline(device, MTLPixelFormatBGRA8Unorm,
+			MTLPixelFormatInvalid) == nil)
+		return nil;
+
+	MTLRenderPipelineDescriptor *desc = [MTLRenderPipelineDescriptor new];
+	desc.vertexFunction = [g_foveatedCopyLibrary newFunctionWithName:@"xr_copy_vertex"];
+	desc.fragmentFunction = [g_foveatedCopyLibrary
+		newFunctionWithName:@"xr_rate_lookup_fragment"];
+	desc.colorAttachments[0].pixelFormat = MTLPixelFormatRG16Float;
+	NSError *error = nil;
+	g_rateLookupPipeline = [device newRenderPipelineStateWithDescriptor:desc
+		error:&error];
+	if (g_rateLookupPipeline == nil)
+	{
+		printf("[xr] rate lookup pipeline failed: %s\n",
+			   error.localizedDescription.UTF8String);
+		fflush(stdout);
+	}
+	return g_rateLookupPipeline;
+}
+
+static bool updateRateLookups()
+{
+	if (g_drawable == nullptr)
+		return false;
+	auto gfx = getMetalGraphics();
+	if (gfx == nullptr)
+		return false;
+	id<MTLTexture> model = cp_drawable_get_color_texture(g_drawable, 0);
+	if (model == nil)
+		return false;
+	id<MTLRenderPipelineState> pipeline = rateLookupPipeline(model.device);
+	if (pipeline == nil)
+		return false;
+
+	constexpr NSUInteger lookupWidth = 256;
+	constexpr NSUInteger lookupHeight = 256;
+	for (int i = 0; i < 2; i++)
+	{
+		if (g_eyeRateLookups[i] != nullptr)
+			continue;
+		MTLTextureDescriptor *desc = [MTLTextureDescriptor
+			texture2DDescriptorWithPixelFormat:MTLPixelFormatRG16Float
+			width:lookupWidth height:lookupHeight mipmapped:NO];
+		desc.storageMode = MTLStorageModePrivate;
+		desc.usage = MTLTextureUsageRenderTarget | MTLTextureUsageShaderRead;
+		id<MTLTexture> texture = [model.device newTextureWithDescriptor:desc];
+		if (texture == nil)
+			return false;
+		g_eyeRateLookups[i] = gfx->newTextureFromHandle((__bridge void *) texture);
+	}
+
+	id<MTLCommandQueue> queue = (__bridge id<MTLCommandQueue>) gfx->getCommandQueue();
+	id<MTLCommandBuffer> cmd = [queue commandBuffer];
+	size_t count = cp_drawable_get_rasterization_rate_map_count(g_drawable);
+	for (int i = 0; i < 2; i++)
+	{
+		id<MTLRasterizationRateMap> map = i < (int) count
+			? cp_drawable_get_flipped_rasterization_rate_map(g_drawable, i) : nil;
+		id<MTLTexture> output = (__bridge id<MTLTexture>)
+			(void *) g_eyeRateLookups[i]->getHandle();
+		if (map == nil || output == nil)
+			continue;
+		MTLSizeAndAlign layout = map.parameterBufferSizeAndAlign;
+		id<MTLBuffer> data = [map.device newBufferWithLength:layout.size
+			options:MTLResourceStorageModeShared];
+		[map copyParameterDataToBuffer:data offset:0];
+
+		MTLRenderPassDescriptor *pass = [MTLRenderPassDescriptor renderPassDescriptor];
+		pass.colorAttachments[0].texture = output;
+		pass.colorAttachments[0].loadAction = MTLLoadActionDontCare;
+		pass.colorAttachments[0].storeAction = MTLStoreActionStore;
+		id<MTLRenderCommandEncoder> enc = [cmd renderCommandEncoderWithDescriptor:pass];
+		[enc setViewport:(MTLViewport){ 0, 0, (double) output.width,
+			(double) output.height, 0, 1 }];
+		[enc setRenderPipelineState:pipeline];
+		[enc setFragmentBuffer:data offset:0 atIndex:0];
+		MTLSize screen = map.screenSize;
+		MTLSize physical = [map physicalSizeForLayer:0];
+		struct {
+			simd_float2 screenSize;
+			simd_float2 physicalSize;
+			simd_float2 outputSize;
+		} uniforms = {
+			{ (float) screen.width, (float) screen.height },
+			{ (float) physical.width, (float) physical.height },
+			{ (float) output.width, (float) output.height }
+		};
+		[enc setFragmentBytes:&uniforms length:sizeof(uniforms) atIndex:1];
+		[enc drawPrimitives:MTLPrimitiveTypeTriangle vertexStart:0 vertexCount:3];
+		[enc endEncoding];
+	}
+	[cmd commit];
+	return true;
+}
+
+static id<MTLRenderPipelineState> foveatedResolvePipeline(id<MTLDevice> device,
+											   MTLPixelFormat colorFormat)
+{
+	uint64_t key = (uint64_t) colorFormat;
+	auto found = g_foveatedResolvePipelines.find(key);
+	if (found != g_foveatedResolvePipelines.end())
+		return found->second;
+
+	// This also creates the shared source library on first use. The returned
+	// copy pipeline is cached for submitFrame and needs no work here.
+	if (g_foveatedCopyLibrary == nil
+		&& foveatedCopyPipeline(device, colorFormat, MTLPixelFormatInvalid) == nil)
+		return nil;
+
+	MTLRenderPipelineDescriptor *desc = [MTLRenderPipelineDescriptor new];
+	desc.vertexFunction = [g_foveatedCopyLibrary newFunctionWithName:@"xr_copy_vertex"];
+	desc.fragmentFunction = [g_foveatedCopyLibrary newFunctionWithName:@"xr_resolve_fragment"];
+	desc.colorAttachments[0].pixelFormat = colorFormat;
+	desc.colorAttachments[1].pixelFormat = MTLPixelFormatR32Float;
+	NSError *error = nil;
+	id<MTLRenderPipelineState> pipeline =
+		[device newRenderPipelineStateWithDescriptor:desc error:&error];
+	if (pipeline == nil)
+	{
+		printf("[xr] foveated resolve pipeline failed: %s\n",
+			   error.localizedDescription.UTF8String);
+		fflush(stdout);
+		return nil;
+	}
+	g_foveatedResolvePipelines[key] = pipeline;
+	return pipeline;
+}
+
+// ---------------------------------------------------------------- C entry
+// Called by the host once SwiftUI hands over the layer renderer.
+extern "C" void love_visionos_setLayerRenderer(void *layerRenderer);
+
+// Withdraw a layer that has gone away, but ONLY if it is still the current
+// one.
+//
+// The renderer thread withdraws its layer after its run loop returns, and the
+// run loop returns when the layer is invalidated. Nothing orders that against
+// the NEXT immersive space installing its own layer -- SwiftUI can and does
+// build the new one while the old thread is still winding down. An
+// unconditional clear then wipes the layer that just arrived, and every
+// subsequent claim finds nothing: the space stays black, which is exactly what
+// re-entry did even after the stale-layer bugs below were fixed.
+extern "C" void love_visionos_clearLayerRenderer(void *layerRenderer)
+{
+	if ((__bridge cp_layer_renderer_t) layerRenderer != g_layer)
+		return;
+	love_visionos_setLayerRenderer(nullptr);
+}
+
+extern "C" void love_visionos_setLayerRenderer(void *layerRenderer)
+{
+	cp_layer_renderer_t incoming = (__bridge cp_layer_renderer_t) layerRenderer;
+	if (incoming == g_layer)
+		return;
+
+	// A DIFFERENT layer (including none) means the immersive space closed and,
+	// perhaps, opened again -- which the player does with the Digital Crown
+	// several times a session. Everything below belongs to the layer that just
+	// went away, and none of it survives the change.
+	//
+	// The claim above all. Leaving it set meant Lua still owned a frame loop
+	// on a dead layer while the host stood down for it, so nothing drew at
+	// all: an entirely black space. And because g_layer was merely stale
+	// rather than null, claim() went on succeeding -- the mod shut down on a
+	// failed poll, started again, claimed the corpse, and repeated. That is
+	// the run of "session created" lines in the log.
+	//
+	// The texture cache has a nastier failure. It is keyed by the raw
+	// MTLTexture pointer, and Metal reuses addresses: a new drawable can land
+	// on the address of a freed one and be handed the love Texture wrapping
+	// the dead original.
+	for (auto &entry : g_eyeTextures)
+	{
+		if (entry.second != nullptr)
+			entry.second->release();
+	}
+	g_eyeTextures.clear();
+	releaseEyeRenderTargets();
+
+	g_frame = nullptr;
+	g_drawable = nullptr;
+	g_eyeSources[0] = nil;
+	g_eyeSources[1] = nil;
+	g_claimed = false;
+	g_layer = incoming;
+
+	// TEMPORARY: re-entering the immersive space still comes back black after
+	// three separate stale-layer fixes, so the lifecycle itself gets printed.
+	// Which layer arrives, which one leaves, and in what order relative to the
+	// thread that is winding down -- guessing at that ordering is what put the
+	// guard in clearLayerRenderer, and it evidently is not the whole story.
+	printf("[xr] layer -> %p\n", (__bridge void *) incoming);
+	fflush(stdout);
+}
+
+extern "C" bool love_visionos_xrClaimed()
+{
+	return g_claimed.load(std::memory_order_acquire);
+}
+
+extern "C" bool love_visionos_beginHostFrame()
+{
+	if (g_claimed.load(std::memory_order_acquire))
+		return false;
+	bool expected = false;
+	if (!g_hostFrameActive.compare_exchange_strong(expected, true,
+			std::memory_order_acq_rel))
+		return false;
+	// claim may have landed between the first check and the exchange.
+	if (g_claimed.load(std::memory_order_acquire))
+	{
+		g_hostFrameActive.store(false, std::memory_order_release);
+		return false;
+	}
+	return true;
+}
+
+extern "C" void love_visionos_endHostFrame()
+{
+	g_hostFrameActive.store(false, std::memory_order_release);
+}
+
+// ---------------------------------------------------------------- Lua API
+
+// Whether a compositor layer is attached RIGHT NOW -- that is, whether a
+// frame can be driven this instant. False in the launcher window, true inside
+// the immersive space.
+static int w_available(lua_State *L)
+{
+	luax_pushboolean(L, g_layer != nullptr);
+	return 1;
+}
+
+// Whether this BUILD can do VR at all. A different question from `available`,
+// and conflating the two cost a whole evening.
+//
+// The mod decides whether to OFFER its VR row when it loads, which is at app
+// start, in the launcher window, before any immersive space exists -- so
+// `available` was false and the row was never added to the settings schema.
+// Entering the space later cannot add it: the schema is built once. The row
+// the player was told to switch on did not exist.
+//
+// This module is only ever registered in a visionOS build, so its presence is
+// the whole answer. Session-liveness questions belong to `available` and
+// `state`, and starting a session when none can start already fails cleanly.
+static int w_supported(lua_State *L)
+{
+	luax_pushboolean(L, true);
+	return 1;
+}
+
+static int w_state(lua_State *L)
+{
+	const char *s = "unavailable";
+	if (g_layer != nullptr)
+	{
+		switch (cp_layer_renderer_get_state(g_layer))
+		{
+		case cp_layer_renderer_state_paused:      s = "paused"; break;
+		case cp_layer_renderer_state_running:     s = "running"; break;
+		case cp_layer_renderer_state_invalidated: s = "invalidated"; break;
+		default: s = "unknown"; break;
+		}
+	}
+	lua_pushstring(L, s);
+	return 1;
+}
+
+/**
+ * Blocks until the compositor wants a frame, then returns its presentation
+ * time in seconds, or nil when there is nothing to draw.
+ *
+ * The wait until optimal input time is the point of the whole exercise:
+ * everything sampled after it -- head pose above all -- is as close as it can
+ * be to the moment the frame is actually shown.
+ */
+/**
+ * Takes the frame loop from the host and brings world tracking up.
+ *
+ * ARKit is started here rather than passed in from the host: its C API is
+ * available, and a provider created on the far side of a language boundary
+ * would have to be handed over as an opaque pointer with a lifetime nobody
+ * owns clearly.
+ */
+static int w_claim(lua_State *L)
+{
+	// Not merely "a layer exists" but "a layer that can still present". A
+	// closed immersive space leaves an invalidated one behind, and claiming
+	// that hands Lua a frame loop that can never produce a frame while the
+	// host stands down for it -- a black space that only a settings toggle
+	// got out of.
+	if (g_layer == nullptr
+		|| cp_layer_renderer_get_state(g_layer) == cp_layer_renderer_state_invalidated)
+	{
+		printf("[xr] claim refused: layer=%p state=%d\n", (__bridge void *) g_layer,
+			   g_layer ? (int) cp_layer_renderer_get_state(g_layer) : -1);
+		fflush(stdout);
+		luax_pushboolean(L, false);
+		return 1;
+	}
+
+	// Publish ownership first, then wait for a fallback frame that may already
+	// be between queryNextFrame and queryDrawable. The old boolean poll allowed
+	// both loops into CompositorServices and aborted in cp_frame_query_drawable.
+	g_claimed.store(true, std::memory_order_release);
+	while (g_hostFrameActive.load(std::memory_order_acquire))
+		usleep(500);
+
+	if (g_worldTracking == nullptr)
+	{
+		g_worldTracking = ar_world_tracking_provider_create(
+			ar_world_tracking_configuration_create());
+
+		ar_data_providers_t providers = ar_data_providers_create();
+		ar_data_providers_add_data_provider(providers, g_worldTracking);
+
+		// Hands, where the device offers them. Not fatal if it does not: the
+		// pad path is unaffected and love.xr.hands simply reports nothing.
+		if (ar_hand_tracking_provider_is_supported())
+		{
+			g_handTracking = ar_hand_tracking_provider_create(
+				ar_hand_tracking_configuration_create());
+			ar_data_providers_add_data_provider(providers, g_handTracking);
+			g_handAnchors[0] = ar_hand_anchor_create();
+			g_handAnchors[1] = ar_hand_anchor_create();
+		}
+
+		g_arSession = ar_session_create();
+
+		// ASK FIRST. ar_session_run does not request authorization -- it just
+		// runs, and a provider whose permission was never granted produces
+		// nothing at all, silently. No prompt ever appeared and the hands
+		// simply did not respond.
+		//
+		// World sensing is requested alongside: it happens to be granted
+		// already because opening an immersive space asks for it, but relying
+		// on that is relying on a side effect.
+		ar_authorization_type_t wanted = ar_authorization_type_world_sensing;
+		if (g_handTracking != nullptr)
+			wanted = (ar_authorization_type_t)
+				(wanted | ar_authorization_type_hand_tracking);
+		ar_session_request_authorization(g_arSession, wanted,
+			^(ar_authorization_results_t results, ar_error_t error) {
+				(void) results;
+				printf("[xr] authorization returned%s\n",
+					   error != nullptr ? " with an error" : "");
+				fflush(stdout);
+			});
+
+		ar_session_run(g_arSession, providers);
+	}
+
+	// This scene measures at a stable 45 submissions/s. One repeat tells the
+	// 90 Hz compositor that cadence explicitly. The old value 2 repeated every
+	// client frame twice in addition to its first display, yielding only 30 new
+	// images/s and the visible trail on head turns.
+	cp_layer_renderer_set_minimum_frame_repeat_count(g_layer, 1);
+	// Quality values above the old ~0.52 default are valid once the layer is
+	// foveated. The final pass consumes its eye-tracked rate maps below.
+	cp_layer_renderer_set_render_quality(g_layer, 1.0f);
+
+	printf("[xr] claim ok on %p\n", (__bridge void *) g_layer);
+	fflush(stdout);
+	luax_pushboolean(L, true);
+	return 1;
+}
+
+static int w_release(lua_State *L)
+{
+	g_claimed = false;
+	// Any frame still open is abandoned deliberately: ending its submission
+	// without a present is a client error the compositor aborts on.
+	g_frame = nullptr;
+	g_drawable = nullptr;
+	g_eyeSources[0] = nil;
+	g_eyeSources[1] = nil;
+	return 0;
+}
+
+static int w_beginFrame(lua_State *L)
+{
+	// Retain the bridged object locally across the timing wait. The Swift host
+	// can withdraw the global layer concurrently when the immersive space ends.
+	cp_layer_renderer_t layer = g_layer;
+	if (layer == nullptr)
+		return 0;
+
+	if (cp_layer_renderer_get_state(layer) == cp_layer_renderer_state_paused)
+		cp_layer_renderer_wait_until_running(layer);
+
+	if (cp_layer_renderer_get_state(layer) != cp_layer_renderer_state_running)
+		return 0;
+
+	cp_frame_t frame = cp_layer_renderer_query_next_frame(layer);
+	if (frame == nullptr)
+		return 0;
+
+	cp_frame_timing_t timing = cp_frame_predict_timing(frame);
+	if (timing == nullptr)
+		return 0;
+
+	cp_frame_start_update(frame);
+	cp_frame_end_update(frame);
+
+	cp_time_wait_until(cp_frame_timing_get_optimal_input_time(timing));
+	// The Crown can invalidate the layer during that wait. Starting submission
+	// on the now-dead frame is a deterministic EXC_BAD_ACCESS inside
+	// cp_frame_start_submission.
+	if (g_layer != layer
+		|| cp_layer_renderer_get_state(layer) != cp_layer_renderer_state_running)
+		return 0;
+
+	// xrOS 26 requires the drawable-array API for foveated layers, and the
+	// query belongs before startSubmission. Prefer the built-in display when a
+	// simultaneous capture target is also present.
+	cp_drawable_array_t drawables = cp_frame_query_drawables(frame);
+	size_t drawableCount = cp_drawable_array_get_count(drawables);
+	cp_drawable_t drawable = nullptr;
+	for (size_t i = 0; i < drawableCount; i++)
+	{
+		cp_drawable_t candidate = cp_drawable_array_get_drawable(drawables, i);
+		if (drawable == nullptr)
+			drawable = candidate;
+		if (cp_drawable_get_target(candidate) == cp_drawable_target_built_in)
+		{
+			drawable = candidate;
+			break;
+		}
+	}
+	if (drawable == nullptr)
+		return 0;
+
+	cp_frame_start_submission(frame);
+	g_frame = frame;
+	g_drawable = drawable;
+	g_eyeSources[0] = nil;
+	g_eyeSources[1] = nil;
+	if (g_drawable == nullptr)
+	{
+		// Deliberately NOT ending submission: the compositor treats "ended
+		// with nothing presented" as a client error and aborts the process.
+		g_frame = nullptr;
+		return 0;
+	}
+
+	static bool loggedDrawable = false;
+	if (!loggedDrawable)
+	{
+		loggedDrawable = true;
+		id<MTLTexture> color = cp_drawable_get_color_texture(g_drawable, 0);
+		size_t mapCount = cp_drawable_get_rasterization_rate_map_count(g_drawable);
+		id<MTLRasterizationRateMap> map =
+			mapCount > 0 ? cp_drawable_get_rasterization_rate_map(g_drawable, 0) : nil;
+		MTLSize screen = map != nil ? map.screenSize : MTLSizeMake(0, 0, 0);
+		MTLSize physical = map != nil ? [map physicalSizeForLayer:0]
+			: MTLSizeMake(color.width, color.height, 0);
+		printf("[xr] drawable %lux%lu, quality %.2f, repeats %d, "
+			   "foveation maps=%lu screen=%lux%lu physical=%lux%lu\n",
+			(unsigned long) color.width, (unsigned long) color.height,
+			(float) cp_layer_renderer_get_render_quality(layer),
+			cp_layer_renderer_get_minimum_frame_repeat_count(layer),
+			(unsigned long) mapCount,
+			(unsigned long) screen.width, (unsigned long) screen.height,
+			(unsigned long) physical.width, (unsigned long) physical.height);
+		fflush(stdout);
+	}
+
+	CFTimeInterval presentTime =
+		cp_time_to_cf_time_interval(cp_frame_timing_get_presentation_time(timing));
+
+	if (g_worldTracking != nullptr)
+	{
+		ar_device_anchor_t anchor = ar_device_anchor_create();
+		auto status = ar_world_tracking_provider_query_device_anchor_at_timestamp(
+			g_worldTracking, presentTime, anchor);
+		if (status == ar_device_anchor_query_status_success)
+		{
+			g_originFromDevice = ar_anchor_get_origin_from_anchor_transform(anchor);
+			updateRigFromOrigin(g_originFromDevice);
+			cp_drawable_set_device_anchor(g_drawable, anchor);
+		}
+	}
+
+	// This depends only on the frame's gaze map, so prepare it before LÖVE
+	// begins either eye. Water can then remap texture UVs without submitting a
+	// command buffer halfway through stereo rendering.
+	updateRateLookups();
+
+	lua_pushnumber(L, (lua_Number) presentTime);
+	return 1;
+}
+
+/**
+ * One camera per eye: position and orientation in world space, plus the four
+ * signed field-of-view angles.
+ *
+ * The angles are derived from the projection matrix rather than read from
+ * cp_view_get_tangents, which is deprecated. They are handed over in OpenXR's
+ * convention -- left and down negative -- because that is what VRRig and
+ * Mat4.fovProjection in the mod already consume, so the mod's camera maths
+ * carries over without a line changed.
+ */
+static int w_views(lua_State *L)
+{
+	if (g_drawable == nullptr)
+		return 0;
+
+	size_t count = cp_drawable_get_view_count(g_drawable);
+	lua_createtable(L, (int) count, 0);
+
+	for (size_t i = 0; i < count; i++)
+	{
+		cp_view_t view = cp_drawable_get_view(g_drawable, i);
+		simd_float4x4 deviceFromView = cp_view_get_transform(view);
+		// Recentred: rigFromOrigin . originFromDevice . deviceFromView.
+		// Without the first term these are ARKit's absolute world coordinates,
+		// and VRRig reads them as if the origin were the head.
+		simd_float4x4 worldFromView =
+			simd_mul(g_rigFromOrigin, simd_mul(g_originFromDevice, deviceFromView));
+
+		simd_float4x4 proj = cp_drawable_compute_projection(
+			g_drawable, cp_axis_direction_convention_right_up_back, i);
+
+		// Tangents out of the projection: for a standard off-centre frustum
+		// P[0][0] = 2n/(r-l) and P[2][0] = (r+l)/(r-l), which rearranges to
+		// these. atan then gives the angles.
+		float tanRight = ( 1.0f + proj.columns[2][0]) / proj.columns[0][0];
+		float tanLeft  = (-1.0f + proj.columns[2][0]) / proj.columns[0][0];
+		float tanUp    = ( 1.0f + proj.columns[2][1]) / proj.columns[1][1];
+		float tanDown  = (-1.0f + proj.columns[2][1]) / proj.columns[1][1];
+
+		simd_float4 pos = worldFromView.columns[3];
+		simd_quatf q = simd_quaternion(worldFromView);
+
+		lua_createtable(L, 0, 4);
+
+		lua_createtable(L, 0, 2);
+		{
+			lua_createtable(L, 3, 0);
+			lua_pushnumber(L, pos.x); lua_rawseti(L, -2, 1);
+			lua_pushnumber(L, pos.y); lua_rawseti(L, -2, 2);
+			lua_pushnumber(L, pos.z); lua_rawseti(L, -2, 3);
+			lua_setfield(L, -2, "pos");
+
+			lua_createtable(L, 4, 0);
+			lua_pushnumber(L, q.vector.x); lua_rawseti(L, -2, 1);
+			lua_pushnumber(L, q.vector.y); lua_rawseti(L, -2, 2);
+			lua_pushnumber(L, q.vector.z); lua_rawseti(L, -2, 3);
+			lua_pushnumber(L, q.vector.w); lua_rawseti(L, -2, 4);
+			lua_setfield(L, -2, "quat");
+		}
+		lua_setfield(L, -2, "pose");
+
+		lua_createtable(L, 0, 4);
+		lua_pushnumber(L, atanf(tanLeft));  lua_setfield(L, -2, "angleLeft");
+		lua_pushnumber(L, atanf(tanRight)); lua_setfield(L, -2, "angleRight");
+		lua_pushnumber(L, atanf(tanUp));    lua_setfield(L, -2, "angleUp");
+		lua_pushnumber(L, atanf(tanDown));  lua_setfield(L, -2, "angleDown");
+		lua_setfield(L, -2, "fov");
+
+		id<MTLTexture> tex = cp_drawable_get_color_texture(g_drawable, i);
+		id<MTLRasterizationRateMap> map =
+			i < cp_drawable_get_rasterization_rate_map_count(g_drawable)
+			? cp_drawable_get_rasterization_rate_map(g_drawable, i) : nil;
+		MTLSize screen = map != nil ? map.screenSize
+			: MTLSizeMake(tex.width, tex.height, 1);
+		lua_pushinteger(L, (lua_Integer) screen.width);  lua_setfield(L, -2, "w");
+		lua_pushinteger(L, (lua_Integer) screen.height); lua_setfield(L, -2, "h");
+
+		lua_rawseti(L, -2, (int) i + 1);
+	}
+
+	return 1;
+}
+
+/** The drawable texture as a model for the linear eye scratch allocation. */
+static int w_eyeCanvas(lua_State *L)
+{
+	int index = (int) luaL_checkinteger(L, 1) - 1;
+	if (!ensureEyeRenderTargets(index))
+		return 0;
+	luax_pushtype(L, g_eyeRenderColors[index]);
+	return 1;
+}
+
+static int w_eyeDepth(lua_State *L)
+{
+	int index = (int) luaL_checkinteger(L, 1) - 1;
+	if (!ensureEyeRenderTargets(index))
+		return 0;
+	luax_pushtype(L, g_eyeRenderDepths[index]);
+	return 1;
+}
+
+static int w_rateMap(lua_State *L)
+{
+	int index = (int) luaL_checkinteger(L, 1) - 1;
+	if (index < 0 || index >= 2 || g_eyeRateLookups[index] == nullptr)
+		return 0;
+	luax_pushtype(L, g_eyeRateLookups[index]);
+	return 1;
+}
+
+static bool ensureResolvedEyeTextures(int index)
+{
+	if (!ensureEyeRenderTargets(index))
+		return false;
+	auto gfx = getMetalGraphics();
+	if (gfx == nullptr)
+		return false;
+
+	id<MTLTexture> sourceColor = (__bridge id<MTLTexture>)
+		(void *) g_eyeRenderColors[index]->getHandle();
+	bool matches = g_eyeResolvedColors[index] != nullptr
+		&& g_eyeResolvedDepths[index] != nullptr;
+	if (matches)
+	{
+		id<MTLTexture> existing = (__bridge id<MTLTexture>)
+			(void *) g_eyeResolvedColors[index]->getHandle();
+		matches = existing.width == sourceColor.width
+			&& existing.height == sourceColor.height
+			&& existing.pixelFormat == sourceColor.pixelFormat;
+	}
+	if (matches)
+		return true;
+
+	if (g_eyeResolvedColors[index] != nullptr)
+		g_eyeResolvedColors[index]->release();
+	if (g_eyeResolvedDepths[index] != nullptr)
+		g_eyeResolvedDepths[index]->release();
+	g_eyeResolvedColors[index] = nullptr;
+	g_eyeResolvedDepths[index] = nullptr;
+
+	MTLTextureDescriptor *colorDesc = [MTLTextureDescriptor
+		texture2DDescriptorWithPixelFormat:sourceColor.pixelFormat
+		width:sourceColor.width height:sourceColor.height mipmapped:NO];
+	colorDesc.storageMode = MTLStorageModePrivate;
+	colorDesc.usage = MTLTextureUsageRenderTarget | MTLTextureUsageShaderRead;
+	id<MTLTexture> color = [sourceColor.device newTextureWithDescriptor:colorDesc];
+
+	MTLTextureDescriptor *depthDesc = [MTLTextureDescriptor
+		texture2DDescriptorWithPixelFormat:MTLPixelFormatR32Float
+		width:sourceColor.width height:sourceColor.height mipmapped:NO];
+	depthDesc.storageMode = MTLStorageModePrivate;
+	depthDesc.usage = MTLTextureUsageRenderTarget | MTLTextureUsageShaderRead;
+	id<MTLTexture> depth = [sourceColor.device newTextureWithDescriptor:depthDesc];
+	if (color == nil || depth == nil)
+		return false;
+
+	g_eyeResolvedColors[index] = gfx->newTextureFromHandle((__bridge void *) color);
+	g_eyeResolvedDepths[index] = gfx->newTextureFromHandle((__bridge void *) depth);
+	return g_eyeResolvedColors[index] != nullptr
+		&& g_eyeResolvedDepths[index] != nullptr;
+}
+
+/**
+ * Snapshots a foveated eye into ordinary normalized-UV color and depth
+ * textures. Screen-space effects cannot sample the packed attachments
+ * directly: a logical UV is not a physical texture UV once VRS is active.
+ */
+static int w_resolveEye(lua_State *L)
+{
+	int index = (int) luaL_checkinteger(L, 1) - 1;
+	if (g_drawable == nullptr || index < 0 || index >= 2
+		|| !ensureResolvedEyeTextures(index))
+		return 0;
+
+	auto metalgfx = getMetalGraphics();
+	if (metalgfx == nullptr)
+		return 0;
+	// Finish terrain before the native pass reads its color and depth.
+	metalgfx->submitXRCommands();
+
+	id<MTLTexture> sourceColor = (__bridge id<MTLTexture>)
+		(void *) g_eyeRenderColors[index]->getHandle();
+	id<MTLTexture> sourceDepth = (__bridge id<MTLTexture>)
+		(void *) g_eyeRenderDepths[index]->getHandle();
+	id<MTLTexture> outColor = (__bridge id<MTLTexture>)
+		(void *) g_eyeResolvedColors[index]->getHandle();
+	id<MTLTexture> outDepth = (__bridge id<MTLTexture>)
+		(void *) g_eyeResolvedDepths[index]->getHandle();
+	id<MTLRasterizationRateMap> map =
+		index < (int) cp_drawable_get_rasterization_rate_map_count(g_drawable)
+			? cp_drawable_get_flipped_rasterization_rate_map(g_drawable, index) : nil;
+	id<MTLRenderPipelineState> pipeline =
+		foveatedResolvePipeline(sourceColor.device, sourceColor.pixelFormat);
+	if (sourceDepth == nil || outColor == nil || outDepth == nil
+		|| map == nil || pipeline == nil)
+		return 0;
+
+	MTLSizeAndAlign layout = map.parameterBufferSizeAndAlign;
+	id<MTLBuffer> rateData = [map.device newBufferWithLength:layout.size
+		options:MTLResourceStorageModeShared];
+	if (rateData == nil)
+		return 0;
+	[map copyParameterDataToBuffer:rateData offset:0];
+
+	id<MTLCommandQueue> queue = (__bridge id<MTLCommandQueue>)
+		metalgfx->getCommandQueue();
+	id<MTLCommandBuffer> cmd = [queue commandBuffer];
+	MTLRenderPassDescriptor *pass = [MTLRenderPassDescriptor renderPassDescriptor];
+	pass.colorAttachments[0].texture = outColor;
+	pass.colorAttachments[0].loadAction = MTLLoadActionDontCare;
+	pass.colorAttachments[0].storeAction = MTLStoreActionStore;
+	pass.colorAttachments[1].texture = outDepth;
+	pass.colorAttachments[1].loadAction = MTLLoadActionDontCare;
+	pass.colorAttachments[1].storeAction = MTLStoreActionStore;
+	id<MTLRenderCommandEncoder> enc = [cmd renderCommandEncoderWithDescriptor:pass];
+	[enc setViewport:(MTLViewport){ 0, 0, (double) outColor.width,
+		(double) outColor.height, 0, 1 }];
+	[enc setRenderPipelineState:pipeline];
+	[enc setFragmentTexture:sourceColor atIndex:0];
+	[enc setFragmentTexture:sourceDepth atIndex:1];
+	[enc setFragmentBuffer:rateData offset:0 atIndex:0];
+	struct { simd_float2 screenSize; simd_float2 outputSize; } uniforms = {
+		{ (float) map.screenSize.width, (float) map.screenSize.height },
+		{ (float) outColor.width, (float) outColor.height }
+	};
+	[enc setFragmentBytes:&uniforms length:sizeof(uniforms) atIndex:1];
+	[enc drawPrimitives:MTLPrimitiveTypeTriangle vertexStart:0 vertexCount:3];
+	[enc endEncoding];
+	[cmd commit];
+
+	luax_pushtype(L, g_eyeResolvedColors[index]);
+	luax_pushtype(L, g_eyeResolvedDepths[index]);
+	return 2;
+}
+
+/**
+ * Records the completed linear eye image. submitFrame commits LÖVE's work,
+ * then maps this image through the drawable's current eye-tracked rate map.
+ */
+static int w_submitEye(lua_State *L)
+{
+	int index = (int) luaL_checkinteger(L, 1) - 1;
+	if (g_drawable == nullptr || index < 0 || index >= 2)
+		return 0;
+
+	love::graphics::Texture *texture = love::graphics::luax_checktexture(L, 2);
+	id<MTLTexture> source = (__bridge id<MTLTexture>) (void *) texture->getHandle();
+	if (source == nil)
+		return 0;
+
+	g_eyeSources[index] = source;
+	luax_pushboolean(L, true);
+	return 1;
+}
+
+static int w_submitFrame(lua_State *L)
+{
+	if (g_frame == nullptr || g_drawable == nullptr)
+		return 0;
+
+	auto metalgfx = getMetalGraphics();
+	if (metalgfx != nullptr)
+		metalgfx->submitXRCommands();
+
+	// The compositor needs a command buffer of its own to schedule the
+	// present against. submitXRCommands above commits the eye renders first;
+	// without it this command buffer wins commit order and presents stale data.
+	// LOVE'S queue, not one of our own.
+	//
+	// Metal orders command buffers within a queue by commit order and orders
+	// nothing between queues. Presenting from a separate queue lets the
+	// compositor show a texture LOVE has not finished writing: while the head
+	// is still it looks fine, and while it turns the moving edges appear
+	// doubled, because part of the frame is the previous one. (The same fault,
+	// in the same shape, as the launcher window's flicker.)
+	id<MTLCommandQueue> queue = nil;
+	if (metalgfx != nullptr)
+		queue = (__bridge id<MTLCommandQueue>) metalgfx->getCommandQueue();
+	if (queue == nil)
+	{
+		// Only before the graphics module exists, which cannot happen on this
+		// path -- kept so a reordering degrades instead of crashing.
+		static id<MTLCommandQueue> fallback = nil;
+		if (fallback == nil)
+			fallback = [MTLCreateSystemDefaultDevice() newCommandQueue];
+		queue = fallback;
+	}
+	id<MTLCommandBuffer> cmd = [queue commandBuffer];
+
+	// Final eye pass: the scene is already in the packed foveated intermediary.
+	// This pass only changes its vertical physical orientation to the one the
+	// compositor expects; the gaze-dependent distribution itself stays intact.
+	size_t textureCount = cp_drawable_get_texture_count(g_drawable);
+	for (size_t i = 0; i < textureCount; i++)
+	{
+		id<MTLTexture> color = cp_drawable_get_color_texture(g_drawable, i);
+		id<MTLTexture> depth = cp_drawable_get_depth_texture(g_drawable, i);
+		if (color == nil)
+			continue;
+		MTLRenderPassDescriptor *pass = [MTLRenderPassDescriptor renderPassDescriptor];
+		pass.colorAttachments[0].texture = color;
+		pass.colorAttachments[0].loadAction = MTLLoadActionClear;
+		pass.colorAttachments[0].storeAction = MTLStoreActionStore;
+		pass.colorAttachments[0].clearColor = MTLClearColorMake(0, 0, 0, 1);
+		if (depth != nil)
+		{
+			pass.depthAttachment.texture = depth;
+			pass.depthAttachment.loadAction = MTLLoadActionClear;
+			pass.depthAttachment.storeAction = MTLStoreActionStore;
+			// Exactly 0 is the far clip plane and the real compositor discards
+			// the image there. 0.1 is safely inside the reverse-Z range.
+			pass.depthAttachment.clearDepth = 0.1;
+		}
+		// Deliberately no rasterizationRateMap here. The source is already a
+		// physically packed foveated image and this shader addresses physical
+		// texels. Applying the map a second time changes position.xy back into
+		// the 6888x5525 logical domain, then treating those values as 2624x2560
+		// physical coordinates bends the image around the gaze point and makes
+		// the two eyes disagree. The flipped source map is the vertical mirror
+		// of the regular destination packing, so a physical Y flip is sufficient.
+
+		id<MTLRenderCommandEncoder> enc = [cmd renderCommandEncoderWithDescriptor:pass];
+		id<MTLTexture> source = i < 2 ? g_eyeSources[i] : nil;
+		id<MTLRenderPipelineState> pipeline = foveatedCopyPipeline(
+			color.device, color.pixelFormat,
+			depth != nil ? depth.pixelFormat : MTLPixelFormatInvalid);
+		if (source != nil && pipeline != nil)
+		{
+			[enc setViewport:(MTLViewport){ 0, 0, (double) color.width,
+				(double) color.height, 0, 1 }];
+			[enc setRenderPipelineState:pipeline];
+			[enc setFragmentTexture:source atIndex:0];
+
+			// Both packings, so the fragment can round-trip through logical
+			// space instead of assuming one is the other's mirror.
+			size_t rateCount = cp_drawable_get_rasterization_rate_map_count(g_drawable);
+			id<MTLRasterizationRateMap> destMap = i < (int) rateCount
+				? cp_drawable_get_rasterization_rate_map(g_drawable, i) : nil;
+			id<MTLRasterizationRateMap> srcMap = i < (int) rateCount
+				? cp_drawable_get_flipped_rasterization_rate_map(g_drawable, i) : nil;
+			id<MTLBuffer> destData = nil, srcData = nil;
+			if (destMap != nil && srcMap != nil)
+			{
+				MTLSizeAndAlign dl = destMap.parameterBufferSizeAndAlign;
+				destData = [destMap.device newBufferWithLength:dl.size
+					options:MTLResourceStorageModeShared];
+				[destMap copyParameterDataToBuffer:destData offset:0];
+				MTLSizeAndAlign sl = srcMap.parameterBufferSizeAndAlign;
+				srcData = [srcMap.device newBufferWithLength:sl.size
+					options:MTLResourceStorageModeShared];
+				[srcMap copyParameterDataToBuffer:srcData offset:0];
+				[enc setFragmentBuffer:destData offset:0 atIndex:0];
+				[enc setFragmentBuffer:srcData offset:0 atIndex:1];
+			}
+			// TEMPORARY: the copy assumes source and destination are packed
+			// identically, so that mirroring a physical row index lands on the
+			// matching logical row. If their physical sizes differ at all, the
+			// scaling below is wrong and the error grows away from the gaze
+			// point -- which is what "only the centre looks right, the rest is
+			// bent like a sphere" looks like.
+			{
+				static bool logged = false;
+				if (!logged)
+				{
+					logged = true;
+					printf("[xr] copy: source %lux%lu -> dest %lux%lu (viewport %lux%lu)\n",
+						   (unsigned long) source.width, (unsigned long) source.height,
+						   (unsigned long) color.width, (unsigned long) color.height,
+						   (unsigned long) color.width, (unsigned long) color.height);
+					fflush(stdout);
+				}
+			}
+			struct {
+				simd_float2 invPhysical;
+				simd_float2 screenSize;
+			} copyUniforms;
+			copyUniforms.invPhysical = (simd_float2){ 1.0f / source.width,
+													 1.0f / source.height };
+			MTLSize screenSize = destMap != nil ? destMap.screenSize
+											    : (MTLSize){ source.width, source.height, 1 };
+			copyUniforms.screenSize = (simd_float2){ (float) screenSize.width,
+													(float) screenSize.height };
+			[enc setFragmentBytes:&copyUniforms length:sizeof(copyUniforms) atIndex:2];
+			[enc drawPrimitives:MTLPrimitiveTypeTriangle vertexStart:0 vertexCount:3];
+		}
+		[enc endEncoding];
+	}
+
+	cp_drawable_encode_present(g_drawable, cmd);
+	[cmd commit];
+
+	cp_frame_end_submission(g_frame);
+
+	// The rate we actually achieve, once a second. If it sits near the display
+	// cadence the frame loop is healthy; if it
+	// wanders, the scene is simply too heavy and the fix is the renderer.
+	{
+		static int frames = 0;
+		static CFTimeInterval last = 0;
+		frames++;
+		CFTimeInterval now = CACurrentMediaTime();
+		if (last == 0) last = now;
+		if (now - last >= 1.0)
+		{
+			printf("[xr] %.1f submitted fps\n", frames / (now - last));
+			fflush(stdout);
+			frames = 0;
+			last = now;
+		}
+	}
+
+	g_frame = nullptr;
+	g_drawable = nullptr;
+	g_eyeSources[0] = nil;
+	g_eyeSources[1] = nil;
+
+	luax_pushboolean(L, true);
+	return 1;
+}
+
+// The PHYSICAL size of this eye's packed attachments.
+//
+// LOVE is told the logical size (that is what makes the scene render at full
+// logical resolution), so nothing in Lua can discover the real one -- and a
+// screen-space pass needs it. Under variable rasterization a fragment's
+// coordinate is physical while love_ScreenSize reports the logical size, so
+// dividing one by the other yields a UV that only reaches physical/logical of
+// the way across. That is roughly 0.38 here, and it is why the water tested
+// its depth against the wrong corner of the frame.
+static int w_eyePhysicalSize(lua_State *L)
+{
+	int index = (int) luaL_checkinteger(L, 1) - 1;
+	if (index < 0 || index >= 2 || !ensureEyeRenderTargets(index))
+		return 0;
+	id<MTLTexture> tex = (__bridge id<MTLTexture>)
+		(void *) g_eyeRenderColors[index]->getHandle();
+	if (tex == nil)
+		return 0;
+	lua_pushinteger(L, (lua_Integer) tex.width);
+	lua_pushinteger(L, (lua_Integer) tex.height);
+	return 2;
+}
+
+// The flat frame, as a Texture Lua can draw with.
+//
+// On visionOS LOVE renders headless into an offscreen "virtual screen", so the
+// 2D UI the game draws every frame -- menus, dialogs, the battle screen -- is
+// already sitting in a texture. OpenXR's path reads it back out of the window's
+// front buffer with raw GL, which does not exist here and would be a copy
+// besides. This hands the texture over directly.
+//
+// Cached like the eye textures: it is created once in setMode and never
+// replaced, and handing Lua a new object each frame would make every canvas
+// cache downstream rebuild itself.
+static love::graphics::Texture *g_screenTexture = nullptr;
+
+static int w_screenTexture(lua_State *L)
+{
+	auto gfx = getMetalGraphics();
+	if (gfx == nullptr)
+		return 0;
+
+	if (g_screenTexture == nullptr)
+	{
+		void *handle = gfx->getVirtualScreenTexture();
+		if (handle == nullptr)
+			return 0;
+		love::graphics::Texture *t = nullptr;
+		luax_catchexcept(L, [&]() { t = gfx->newTextureFromHandle(handle); });
+		if (t == nullptr)
+			return 0;
+		g_screenTexture = t;
+	}
+
+	luax_pushtype(L, g_screenTexture);
+	return 1;
+}
+
+// ---------------------------------------------------------------- hands
+
+// Distance between two named joints, in metres, or a negative number when
+// either is missing. Joint transforms are ANCHOR-relative, so a distance
+// between two of them needs no world conversion -- and is the same number
+// wherever the hand happens to be.
+static float jointGap(ar_hand_skeleton_t skel,
+                      ar_hand_skeleton_joint_name_t a,
+                      ar_hand_skeleton_joint_name_t b)
+{
+	if (skel == nullptr)
+		return -1.0f;
+	ar_skeleton_joint_t ja = ar_hand_skeleton_get_joint_named(skel, a);
+	ar_skeleton_joint_t jb = ar_hand_skeleton_get_joint_named(skel, b);
+	if (ja == nullptr || jb == nullptr)
+		return -1.0f;
+	simd_float4 pa = ar_skeleton_joint_get_anchor_from_joint_transform(ja).columns[3];
+	simd_float4 pb = ar_skeleton_joint_get_anchor_from_joint_transform(jb).columns[3];
+	return simd_length(simd_make_float3(pa.x - pb.x, pa.y - pb.y, pa.z - pb.z));
+}
+
+// A pinch is the tips touching. 25 mm is generous on purpose: the tracker's
+// tip estimate wanders a few millimetres, and a threshold tight enough to feel
+// precise is one that drops the gesture mid-hold.
+// The position of a named joint, in ANCHOR space.
+static bool jointPos(ar_hand_skeleton_t skel,
+                     ar_hand_skeleton_joint_name_t name,
+                     simd_float3 *out)
+{
+	if (skel == nullptr)
+		return false;
+	ar_skeleton_joint_t j = ar_hand_skeleton_get_joint_named(skel, name);
+	if (j == nullptr)
+		return false;
+	simd_float4 p = ar_skeleton_joint_get_anchor_from_joint_transform(j).columns[3];
+	*out = simd_make_float3(p.x, p.y, p.z);
+	return true;
+}
+
+// The palm's middle, in ANCHOR space -- a POSITION correction only.
+//
+// ARKit's hand anchor sits at the wrist, so the pokedex hung halfway up the
+// forearm; the mod's offsets are tuned against OpenXR's grip pose, which is in
+// the palm. This moves the origin there and changes nothing else.
+//
+// A full basis derived from knuckle positions was tried and was worse. The
+// anchor's own rotation follows the arm cleanly, and a hand-built one does not
+// -- it is only as steady as four joint estimates, and it inherits their
+// jitter. Whatever is left wrong about the ORIENTATION is a fixed rotation,
+// and a fixed rotation belongs in lib/Pokedex.lua's TILT beside the offsets it
+// was tuned with, where it can be changed without rebuilding the engine.
+static bool palmCentre(ar_hand_skeleton_t skel, simd_float4x4 *out)
+{
+	simd_float3 wrist, midKnuckle;
+	if (!jointPos(skel, ar_hand_skeleton_joint_name_wrist, &wrist)
+		|| !jointPos(skel, ar_hand_skeleton_joint_name_middle_finger_knuckle, &midKnuckle))
+		return false;
+	simd_float3 origin = (wrist + midKnuckle) * 0.5f;
+	simd_float4x4 m = matrix_identity_float4x4;
+	m.columns[3] = simd_make_float4(origin.x, origin.y, origin.z, 1.0f);
+	*out = m;
+	return true;
+}
+
+static const float PINCH_GAP = 0.025f;
+// A closed hand, measured as the fingertips folded back to the wrist. An open
+// hand puts them 0.16-0.18 m out, a fist about 0.07 -- so this sits well clear
+// of both.
+static const float FIST_GAP = 0.10f;
+
+/**
+ * The hands, as gestures rather than skeletons.
+ *
+ * Lua gets what it can act on -- a pose and a handful of booleans -- and not
+ * twenty-seven joints it would have to do trigonometry on. The thresholds live
+ * here beside the measurements they came from.
+ */
+static int w_hands(lua_State *L)
+{
+	lua_createtable(L, 2, 0);
+	if (g_handTracking == nullptr)
+		return 1;
+
+	ar_hand_tracking_provider_get_latest_anchors(g_handTracking,
+												 g_handAnchors[0],
+												 g_handAnchors[1]);
+
+	for (int i = 0; i < 2; i++)
+	{
+		lua_createtable(L, 0, 6);
+		ar_hand_anchor_t anchor = g_handAnchors[i];
+		bool tracked = anchor != nullptr && ar_hand_anchor_is_tracked(anchor);
+
+		lua_pushboolean(L, tracked);
+		lua_setfield(L, -2, "tracked");
+
+		if (tracked)
+		{
+			// Recentred exactly as the head is: the rig reads these in the
+			// same space it reads the eyes in, or the pokedex would hang a
+			// metre off the hand holding it.
+			ar_hand_skeleton_t skel = ar_hand_anchor_get_hand_skeleton(anchor);
+			simd_float4x4 anchorFromGrip = matrix_identity_float4x4;
+			simd_float4x4 originFromAnchor =
+				ar_hand_anchor_get_origin_from_anchor_transform(anchor);
+			// The palm where the skeleton allows it; the bare anchor is the
+			// fallback, and it is the wrist.
+			if (!palmCentre(skel, &anchorFromGrip))
+				anchorFromGrip = matrix_identity_float4x4;
+			simd_float4x4 world = simd_mul(g_rigFromOrigin,
+				simd_mul(originFromAnchor, anchorFromGrip));
+			simd_float4 pos = world.columns[3];
+			simd_quatf q = simd_quaternion(world);
+
+			lua_createtable(L, 0, 2);
+			lua_createtable(L, 3, 0);
+			lua_pushnumber(L, pos.x); lua_rawseti(L, -2, 1);
+			lua_pushnumber(L, pos.y); lua_rawseti(L, -2, 2);
+			lua_pushnumber(L, pos.z); lua_rawseti(L, -2, 3);
+			lua_setfield(L, -2, "pos");
+			lua_createtable(L, 4, 0);
+			lua_pushnumber(L, q.vector.x); lua_rawseti(L, -2, 1);
+			lua_pushnumber(L, q.vector.y); lua_rawseti(L, -2, 2);
+			lua_pushnumber(L, q.vector.z); lua_rawseti(L, -2, 3);
+			lua_pushnumber(L, q.vector.w); lua_rawseti(L, -2, 4);
+			lua_setfield(L, -2, "quat");
+			lua_setfield(L, -2, "pose");
+
+			float indexGap = jointGap(skel,
+				ar_hand_skeleton_joint_name_thumb_tip,
+				ar_hand_skeleton_joint_name_index_finger_tip);
+			float middleGap = jointGap(skel,
+				ar_hand_skeleton_joint_name_thumb_tip,
+				ar_hand_skeleton_joint_name_middle_finger_tip);
+
+			lua_pushboolean(L, indexGap >= 0 && indexGap < PINCH_GAP);
+			lua_setfield(L, -2, "pinchIndex");
+			lua_pushboolean(L, middleGap >= 0 && middleGap < PINCH_GAP);
+			lua_setfield(L, -2, "pinchMiddle");
+
+			// A fist: the three long fingers folded to the wrist together.
+			// Testing all three keeps a pointing hand or a pinch from
+			// counting -- one finger down is not a fist.
+			float w1 = jointGap(skel, ar_hand_skeleton_joint_name_wrist,
+				ar_hand_skeleton_joint_name_index_finger_tip);
+			float w2 = jointGap(skel, ar_hand_skeleton_joint_name_wrist,
+				ar_hand_skeleton_joint_name_middle_finger_tip);
+			float w3 = jointGap(skel, ar_hand_skeleton_joint_name_wrist,
+				ar_hand_skeleton_joint_name_ring_finger_tip);
+			bool fist = w1 >= 0 && w2 >= 0 && w3 >= 0
+					 && w1 < FIST_GAP && w2 < FIST_GAP && w3 < FIST_GAP;
+			lua_pushboolean(L, fist);
+			lua_setfield(L, -2, "fist");
+		}
+
+		lua_rawseti(L, -2, i + 1);
+	}
+	return 1;
+}
+
+static const luaL_Reg functions[] =
+{
+	{ "available",   w_available   },
+	{ "supported",   w_supported   },
+	{ "claim",       w_claim       },
+	{ "release",     w_release     },
+	{ "state",       w_state       },
+	{ "beginFrame",  w_beginFrame  },
+	{ "views",       w_views       },
+	{ "eyeCanvas",   w_eyeCanvas   },
+	{ "screenTexture", w_screenTexture },
+	{ "eyeDepth",    w_eyeDepth    },
+	{ "rateMap",     w_rateMap     },
+	{ "hands",       w_hands       },
+	{ "eyePhysicalSize", w_eyePhysicalSize },
+	{ "resolveEye",  w_resolveEye  },
+	{ "submitEye",   w_submitEye   },
+	{ "submitFrame", w_submitFrame },
+	{ 0, 0 }
+};
+
+extern "C" int luaopen_love_xr(lua_State *L)
+{
+	lua_newtable(L);
+	luax_register(L, nullptr, functions);
+	return 1;
+}
+
+} // xr
+} // love
+
+#endif // LOVE_VISIONOS
