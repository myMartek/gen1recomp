+Texture::Texture(love::graphics::Graphics *gfxbase, id<MTLDevice> device, id<MTLTexture> adopted, const Settings &settings)
+	: love::graphics::Texture(gfxbase, settings, nullptr)
+{ @autoreleasepool {
+	// Adopting rather than allocating: this is a CompositorServices drawable,
+	// which belongs to the compositor and is recycled frame to frame. Nothing
+	// is created here and nothing may be released.
+	// ARC makes sharing safe without an ownership flag: assigning retains, and
+	// the destructor's `texture = nil` releases only OUR reference. The
+	// compositor keeps its own for as long as the drawable lives.
+	texture = adopted;
+
+	if (texture == nil)
+		throw love::Exception("Cannot adopt a null Metal texture.");
+
+	// No MSAA path: a drawable is handed over already resolved, and allocating
+	// a private MSAA companion for a texture we do not own would quietly
+	// double the memory the compositor is already budgeting.
+	actualMSAASamples = 1;
+
+	if (!debugName.empty())
+		texture.label = @(debugName.c_str());
+
+	// Deliberately no updateGraphicsMemorySize(): the compositor's drawables
+	// are not ours, and counting them would make love.graphics.getStats()
+	// report memory this process did not allocate.
+
+	setSamplerState(samplerState);
+}}
