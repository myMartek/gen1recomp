+// Metal -> LOVE, for the handful of colour formats CompositorServices
+// actually hands out. Deliberately not exhaustive: an unknown format here
+// means a drawable we do not understand, and guessing at it would produce
+// silently wrong colours rather than an error.
+static love::PixelFormat lovePixelFormatFromMTL(MTLPixelFormat fmt)
+{
+	switch (fmt)
+	{
+	case MTLPixelFormatBGRA8Unorm:      return love::PIXELFORMAT_BGRA8_UNORM;
+	case MTLPixelFormatBGRA8Unorm_sRGB: return love::PIXELFORMAT_BGRA8_sRGB;
+	case MTLPixelFormatRGBA8Unorm:      return love::PIXELFORMAT_RGBA8_UNORM;
+	case MTLPixelFormatRGBA8Unorm_sRGB: return love::PIXELFORMAT_RGBA8_sRGB;
+	case MTLPixelFormatRGBA16Float:     return love::PIXELFORMAT_RGBA16_FLOAT;
+	default:                            return love::PIXELFORMAT_UNKNOWN;
+	}
+}
+
+love::graphics::Texture *Graphics::newTextureFromHandle(void *mtlTexture)
+{ @autoreleasepool {
+	id<MTLTexture> mtl = (__bridge id<MTLTexture>) mtlTexture;
+	if (mtl == nil)
+		return nullptr;
+
+	// Describe the incoming texture rather than requesting one: width, height
+	// and format all come from what Metal already made.
+	love::graphics::Texture::Settings settings;
+	settings.width = (int) mtl.width;
+	settings.height = (int) mtl.height;
+	settings.renderTarget = true;
+	settings.readable.set(true);
+	settings.mipmaps = love::graphics::Texture::MIPMAPS_NONE;
+	settings.msaa = 1;
+	settings.dpiScale = 1.0f;
+	settings.format = lovePixelFormatFromMTL(mtl.pixelFormat);
+	if (settings.format == love::PIXELFORMAT_UNKNOWN)
+		throw love::Exception("Unsupported Metal pixel format for an adopted texture.");
+
+	return new Texture(this, device, mtl, settings);
+}}
