+
+// The backbuffer LOVE has been drawing into, as an id<MTLTexture>. Returns
+// null before setMode, and whenever the app is presenting through a layer
+// (the flat build) rather than headless.
+extern "C" void *love_visionos_virtualScreenTexture()
+{
+	auto gfx = Module::getInstance<love::graphics::Graphics>(Module::M_GRAPHICS);
+	if (gfx == nullptr)
+		return nullptr;
+	auto metalgfx = dynamic_cast<love::graphics::metal::Graphics *>(gfx);
+	if (metalgfx == nullptr)
+		return nullptr;
+	return metalgfx->getVirtualScreenTexture();
+}
+
+// The Metal command queue LOVE submits on.
+//
+// The shell needs this because the virtual screen has two readers -- the flat
+// launcher window and, in the immersive space, the panel the frame is mapped
+// onto -- and both of them were sampling a texture LOVE writes from its own
+// thread. Metal orders nothing between separate queues, so a reader could
+// encode its sample in between LOVE's clear and LOVE's draws and come away
+// with an empty frame. Intermittently, which is exactly what it looked like:
+// flicker.
+//
+// Command buffers committed to one queue execute in commit order, so putting
+// the readers on LOVE's queue removes the race rather than narrowing it. The
+// cost is that a reader's frame cannot overlap LOVE's on the GPU; at these
+// resolutions that is far cheaper than the alternative, which is a rotating
+// set of eye-sized snapshot textures plus an MTLSharedEvent to order them.
+extern "C" void *love_visionos_commandQueue()
+{
+	auto gfx = Module::getInstance<love::graphics::Graphics>(Module::M_GRAPHICS);
+	if (gfx == nullptr)
+		return nullptr;
+	auto metalgfx = dynamic_cast<love::graphics::metal::Graphics *>(gfx);
+	if (metalgfx == nullptr)
+		return nullptr;
+	return metalgfx->getCommandQueue();
+}
+#endif
