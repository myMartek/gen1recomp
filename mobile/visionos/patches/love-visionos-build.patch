@@ -27,6 +27,12 @@
 
 #ifdef LOVE_BUILD_EXE
 
+// SDL_main.h renames our main() to SDL_main and supplies a real main() that
+// calls it. A target providing its own entry point (the SwiftUI shell) must
+// opt out of that, or the link fails on an undefined _SDL_main.
