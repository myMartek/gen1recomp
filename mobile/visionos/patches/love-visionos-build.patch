+// ---------------------------------------------------------------- visionOS
+// The visionOS shell drives LOVE without a presentable layer: frames go to
+// CompositorServices drawables, and the flat 2D image is a texture the app
+// shows in a window or in-world. These three functions are the whole of the
+// C surface that needs, kept here rather than in a new module so the patch
+// stays inside files that already exist.
+#ifdef LOVE_VISIONOS
+static bool g_visionosHeadless = false;
+
+extern "C" void love_visionos_setHeadless(bool headless)
+{
+	g_visionosHeadless = headless;
+}
+
+extern "C" bool love_visionos_getHeadless()
+{
+	return g_visionosHeadless;
+}
+
+// The backbuffer LOVE has been drawing into, as an id<MTLTexture>. Returns
+// null before setMode, and whenever the app is presenting through a layer
+// (the flat build) rather than headless.
+extern "C" void *love_visionos_virtualScreenTexture()
+{
+	auto gfx = Module::getInstance<love::graphics::Graphics>(Module::M_GRAPHICS);
+	if (gfx == nullptr)
+		return nullptr;
+	auto metalgfx = dynamic_cast<love::graphics::metal::Graphics *>(gfx);
+	if (metalgfx == nullptr)
+		return nullptr;
+	return metalgfx->getVirtualScreenTexture();
+}
+#endif
+
 bool Graphics::setMode(void *context, const BackbufferSettings &settings)
 { @autoreleasepool {
 	this->metalLayer = (__bridge CAMetalLayer *) context;
 
+	// A null context means there is nothing to present to: visionOS, where the
+	// frame goes to CompositorServices drawables rather than to a layer. Stand
+	// an ordinary offscreen texture in for the drawable so the whole of the
+	// rest of the backend -- render passes, MSAA resolve, screenshots -- keeps
+	// working unchanged.
+	if (metalLayer == nil)
+	{
+		MTLTextureDescriptor *desc = [MTLTextureDescriptor
+			texture2DDescriptorWithPixelFormat:(isGammaCorrect() ? MTLPixelFormatBGRA8Unorm_sRGB : MTLPixelFormatBGRA8Unorm)
+										 width:std::max(1, settings.pixelWidth)
+										height:std::max(1, settings.pixelHeight)
+									 mipmapped:NO];
+		desc.usage = MTLTextureUsageRenderTarget | MTLTextureUsageShaderRead;
+		desc.storageMode = MTLStorageModePrivate;
+		virtualScreen = [device newTextureWithDescriptor:desc];
+		if (virtualScreen == nil)
+			throw love::Exception("Out of graphics memory (virtual screen).");
+
+		backbufferChanged(settings);
+		created = true;
+		restoreState(states.back());
+		return true;
+	}
+
 	metalLayer.device = device;
 	metalLayer.pixelFormat = isGammaCorrect() ? MTLPixelFormatBGRA8Unorm_sRGB : MTLPixelFormatBGRA8Unorm;
 
