+// Where LOVE actually writes -- the one authority on it. Guessing this from
+// the platform conventions is how a ROM ends up in a directory the engine
+// never looks at.
+extern "C" const char *love_visionos_saveDirectory()
+{
+	static std::string dir;
+	auto fs = Module::getInstance<love::filesystem::Filesystem>(Module::M_FILESYSTEM);
+	if (fs == nullptr)
+		return "";
+	dir = fs->getSaveDirectory();
+	return dir.c_str();
