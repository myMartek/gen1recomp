diff --git a/src/modules/xr/wrap_XR.h b/src/modules/xr/wrap_XR.h
new file mode 100644
index 0000000..05bf9ce
--- /dev/null
+++ b/src/modules/xr/wrap_XR.h
@@ -0,0 +1,21 @@
+/**
+ * love.xr -- CompositorServices and ARKit, for visionOS. See wrap_XR.mm.
+ */
+
+#ifndef LOVE_XR_WRAP_XR_H
+#define LOVE_XR_WRAP_XR_H
+
+#include "common/config.h"
+#include "common/runtime.h"
+
+#ifdef LOVE_VISIONOS
+
+extern "C" int luaopen_love_xr(lua_State *L);
+
+/// Handed over by the host once SwiftUI has a layer renderer and ARKit is up.
+extern "C" void love_visionos_setLayerRenderer(void *layerRenderer);
+/// True while Lua owns the frame loop; the host's renderer stands down.
+extern "C" bool love_visionos_xrClaimed(void);
+
+#endif // LOVE_VISIONOS
+#endif // LOVE_XR_WRAP_XR_H
diff --git a/src/modules/xr/wrap_XR.mm b/src/modules/xr/wrap_XR.mm
new file mode 100644
index 0000000..9337f47
--- /dev/null
+++ b/src/modules/xr/wrap_XR.mm
@@ -0,0 +1,516 @@
+/**
+ * love.xr -- CompositorServices and ARKit, for visionOS.
+ *
+ * This exists so a Lua renderer can draw a stereo frame: ask for a frame, read
+ * one camera per eye, draw into the drawable textures, submit. The voxel mod
+ * already renders per eye for OpenXR on Windows; this is the same shape with a
+ * different backend underneath.
+ *
+ * Two deliberate decisions:
+ *
+ * It is a plain table of functions, not a love Module. A Module would need an
+ * entry in Module::ModuleType, which is a header every part of LOVE includes --
+ * a much larger patch for nothing, since nothing here needs module lifecycle.
+ *
+ * LUA DRIVES THE FRAME LOOP. beginFrame() blocks until the compositor is ready
+ * and returns the pose for the frame being submitted. The alternative -- a
+ * render loop in the host calling into Lua -- would leave LOVE rendering with
+ * whatever head pose it happened to have, and by submission that pose is
+ * already stale. Everything about the timing here follows from that.
+ *
+ * Nothing that crosses into Lua is a pointer: poses and angles come back as
+ * plain tables, matching the discipline lib/VRXR.lua already keeps for OpenXR.
+ */
+
+#include "common/config.h"
+
+#ifdef LOVE_VISIONOS
+
+#include "wrap_XR.h"
+
+#include <cstdio>   // TEMPORARY: lifecycle logging, see the [xr] prints below
+
+#include "common/runtime.h"
+#include "common/Exception.h"
+#include "graphics/Graphics.h"
+#include "graphics/Texture.h"
+#include "graphics/metal/Graphics.h"
+
+#import <ARKit/ARKit.h>
+#import <CompositorServices/CompositorServices.h>
+#import <Metal/Metal.h>
+#import <simd/simd.h>
+
+namespace love
+{
+namespace xr
+{
+
+// ---------------------------------------------------------------- state
+// One frame in flight at a time, which is what the Lua side can express: it
+// calls beginFrame, draws, then submitFrame. Holding these here rather than
+// handing opaque values to Lua keeps cdata out of the mod entirely.
+static cp_layer_renderer_t g_layer = nullptr;
+static ar_session_t g_arSession = nullptr;
+static ar_world_tracking_provider_t g_worldTracking = nullptr;
+
+// Set while Lua owns the frame loop. The host's own renderer polls this and
+// stands down: two loops calling cp_frame_* on one layer would be a race, and
+// the host keeps drawing until the mod actually turns VR on.
+static bool g_claimed = false;
+
+static cp_frame_t g_frame = nullptr;
+static cp_drawable_t g_drawable = nullptr;
+static simd_float4x4 g_originFromDevice = matrix_identity_float4x4;
+
+// A love Texture per drawable texture, kept alive across frames. The
+// compositor recycles a small ring of drawables, so this settles at a handful
+// of entries rather than allocating one per frame -- and the mod's own canvas
+// caches key off the object, so handing it a new one each frame would make it
+// rebuild everything sixty times a second.
+static std::map<void *, love::graphics::Texture *> g_eyeTextures;
+
+static love::graphics::metal::Graphics *getMetalGraphics()
+{
+	auto gfx = Module::getInstance<love::graphics::Graphics>(Module::M_GRAPHICS);
+	return dynamic_cast<love::graphics::metal::Graphics *>(gfx);
+}
+
+// ---------------------------------------------------------------- C entry
+// Called by the host once SwiftUI hands over the layer renderer.
+extern "C" void love_visionos_setLayerRenderer(void *layerRenderer);
+
+// Withdraw a layer that has gone away, but ONLY if it is still the current
+// one.
+//
+// The renderer thread withdraws its layer after its run loop returns, and the
+// run loop returns when the layer is invalidated. Nothing orders that against
+// the NEXT immersive space installing its own layer -- SwiftUI can and does
+// build the new one while the old thread is still winding down. An
+// unconditional clear then wipes the layer that just arrived, and every
+// subsequent claim finds nothing: the space stays black, which is exactly what
+// re-entry did even after the stale-layer bugs below were fixed.
+extern "C" void love_visionos_clearLayerRenderer(void *layerRenderer)
+{
+	if ((__bridge cp_layer_renderer_t) layerRenderer != g_layer)
+		return;
+	love_visionos_setLayerRenderer(nullptr);
+}
+
+extern "C" void love_visionos_setLayerRenderer(void *layerRenderer)
+{
+	cp_layer_renderer_t incoming = (__bridge cp_layer_renderer_t) layerRenderer;
+	if (incoming == g_layer)
+		return;
+
+	// A DIFFERENT layer (including none) means the immersive space closed and,
+	// perhaps, opened again -- which the player does with the Digital Crown
+	// several times a session. Everything below belongs to the layer that just
+	// went away, and none of it survives the change.
+	//
+	// The claim above all. Leaving it set meant Lua still owned a frame loop
+	// on a dead layer while the host stood down for it, so nothing drew at
+	// all: an entirely black space. And because g_layer was merely stale
+	// rather than null, claim() went on succeeding -- the mod shut down on a
+	// failed poll, started again, claimed the corpse, and repeated. That is
+	// the run of "session created" lines in the log.
+	//
+	// The texture cache has a nastier failure. It is keyed by the raw
+	// MTLTexture pointer, and Metal reuses addresses: a new drawable can land
+	// on the address of a freed one and be handed the love Texture wrapping
+	// the dead original.
+	for (auto &entry : g_eyeTextures)
+	{
+		if (entry.second != nullptr)
+			entry.second->release();
+	}
+	g_eyeTextures.clear();
+
+	g_frame = nullptr;
+	g_drawable = nullptr;
+	g_claimed = false;
+	g_layer = incoming;
+
+	// TEMPORARY: re-entering the immersive space still comes back black after
+	// three separate stale-layer fixes, so the lifecycle itself gets printed.
+	// Which layer arrives, which one leaves, and in what order relative to the
+	// thread that is winding down -- guessing at that ordering is what put the
+	// guard in clearLayerRenderer, and it evidently is not the whole story.
+	printf("[xr] layer -> %p\n", (__bridge void *) incoming);
+	fflush(stdout);
+}
+
+extern "C" bool love_visionos_xrClaimed()
+{
+	return g_claimed;
+}
+
+// ---------------------------------------------------------------- Lua API
+
+// Whether a compositor layer is attached RIGHT NOW -- that is, whether a
+// frame can be driven this instant. False in the launcher window, true inside
+// the immersive space.
+static int w_available(lua_State *L)
+{
+	luax_pushboolean(L, g_layer != nullptr);
+	return 1;
+}
+
+// Whether this BUILD can do VR at all. A different question from `available`,
+// and conflating the two cost a whole evening.
+//
+// The mod decides whether to OFFER its VR row when it loads, which is at app
+// start, in the launcher window, before any immersive space exists -- so
+// `available` was false and the row was never added to the settings schema.
+// Entering the space later cannot add it: the schema is built once. The row
+// the player was told to switch on did not exist.
+//
+// This module is only ever registered in a visionOS build, so its presence is
+// the whole answer. Session-liveness questions belong to `available` and
+// `state`, and starting a session when none can start already fails cleanly.
+static int w_supported(lua_State *L)
+{
+	luax_pushboolean(L, true);
+	return 1;
+}
+
+static int w_state(lua_State *L)
+{
+	const char *s = "unavailable";
+	if (g_layer != nullptr)
+	{
+		switch (cp_layer_renderer_get_state(g_layer))
+		{
+		case cp_layer_renderer_state_paused:      s = "paused"; break;
+		case cp_layer_renderer_state_running:     s = "running"; break;
+		case cp_layer_renderer_state_invalidated: s = "invalidated"; break;
+		default: s = "unknown"; break;
+		}
+	}
+	lua_pushstring(L, s);
+	return 1;
+}
+
+/**
+ * Blocks until the compositor wants a frame, then returns its presentation
+ * time in seconds, or nil when there is nothing to draw.
+ *
+ * The wait until optimal input time is the point of the whole exercise:
+ * everything sampled after it -- head pose above all -- is as close as it can
+ * be to the moment the frame is actually shown.
+ */
+/**
+ * Takes the frame loop from the host and brings world tracking up.
+ *
+ * ARKit is started here rather than passed in from the host: its C API is
+ * available, and a provider created on the far side of a language boundary
+ * would have to be handed over as an opaque pointer with a lifetime nobody
+ * owns clearly.
+ */
+static int w_claim(lua_State *L)
+{
+	// Not merely "a layer exists" but "a layer that can still present". A
+	// closed immersive space leaves an invalidated one behind, and claiming
+	// that hands Lua a frame loop that can never produce a frame while the
+	// host stands down for it -- a black space that only a settings toggle
+	// got out of.
+	if (g_layer == nullptr
+		|| cp_layer_renderer_get_state(g_layer) == cp_layer_renderer_state_invalidated)
+	{
+		printf("[xr] claim refused: layer=%p state=%d\n", (__bridge void *) g_layer,
+			   g_layer ? (int) cp_layer_renderer_get_state(g_layer) : -1);
+		fflush(stdout);
+		luax_pushboolean(L, false);
+		return 1;
+	}
+
+	if (g_worldTracking == nullptr)
+	{
+		g_worldTracking = ar_world_tracking_provider_create(
+			ar_world_tracking_configuration_create());
+
+		ar_data_providers_t providers = ar_data_providers_create();
+		ar_data_providers_add_data_provider(providers, g_worldTracking);
+
+		g_arSession = ar_session_create();
+		ar_session_run(g_arSession, providers);
+	}
+
+	g_claimed = true;
+	printf("[xr] claim ok on %p\n", (__bridge void *) g_layer);
+	fflush(stdout);
+	luax_pushboolean(L, true);
+	return 1;
+}
+
+static int w_release(lua_State *L)
+{
+	g_claimed = false;
+	// Any frame still open is abandoned deliberately: ending its submission
+	// without a present is a client error the compositor aborts on.
+	g_frame = nullptr;
+	g_drawable = nullptr;
+	return 0;
+}
+
+static int w_beginFrame(lua_State *L)
+{
+	if (g_layer == nullptr)
+		return 0;
+
+	if (cp_layer_renderer_get_state(g_layer) == cp_layer_renderer_state_paused)
+		cp_layer_renderer_wait_until_running(g_layer);
+
+	if (cp_layer_renderer_get_state(g_layer) != cp_layer_renderer_state_running)
+		return 0;
+
+	g_frame = cp_layer_renderer_query_next_frame(g_layer);
+	if (g_frame == nullptr)
+		return 0;
+
+	cp_frame_timing_t timing = cp_frame_predict_timing(g_frame);
+	if (timing == nullptr)
+	{
+		g_frame = nullptr;
+		return 0;
+	}
+
+	cp_frame_start_update(g_frame);
+	cp_frame_end_update(g_frame);
+
+	cp_time_wait_until(cp_frame_timing_get_optimal_input_time(timing));
+
+	cp_frame_start_submission(g_frame);
+	g_drawable = cp_frame_query_drawable(g_frame);
+	if (g_drawable == nullptr)
+	{
+		// Deliberately NOT ending submission: the compositor treats "ended
+		// with nothing presented" as a client error and aborts the process.
+		g_frame = nullptr;
+		return 0;
+	}
+
+	CFTimeInterval presentTime =
+		cp_time_to_cf_time_interval(cp_frame_timing_get_presentation_time(timing));
+
+	if (g_worldTracking != nullptr)
+	{
+		ar_device_anchor_t anchor = ar_device_anchor_create();
+		auto status = ar_world_tracking_provider_query_device_anchor_at_timestamp(
+			g_worldTracking, presentTime, anchor);
+		if (status == ar_device_anchor_query_status_success)
+		{
+			g_originFromDevice = ar_anchor_get_origin_from_anchor_transform(anchor);
+			cp_drawable_set_device_anchor(g_drawable, anchor);
+		}
+	}
+
+	lua_pushnumber(L, (lua_Number) presentTime);
+	return 1;
+}
+
+/**
+ * One camera per eye: position and orientation in world space, plus the four
+ * signed field-of-view angles.
+ *
+ * The angles are derived from the projection matrix rather than read from
+ * cp_view_get_tangents, which is deprecated. They are handed over in OpenXR's
+ * convention -- left and down negative -- because that is what VRRig and
+ * Mat4.fovProjection in the mod already consume, so the mod's camera maths
+ * carries over without a line changed.
+ */
+static int w_views(lua_State *L)
+{
+	if (g_drawable == nullptr)
+		return 0;
+
+	size_t count = cp_drawable_get_view_count(g_drawable);
+	lua_createtable(L, (int) count, 0);
+
+	for (size_t i = 0; i < count; i++)
+	{
+		cp_view_t view = cp_drawable_get_view(g_drawable, i);
+		simd_float4x4 deviceFromView = cp_view_get_transform(view);
+		simd_float4x4 worldFromView = simd_mul(g_originFromDevice, deviceFromView);
+
+		simd_float4x4 proj = cp_drawable_compute_projection(
+			g_drawable, cp_axis_direction_convention_right_up_back, i);
+
+		// Tangents out of the projection: for a standard off-centre frustum
+		// P[0][0] = 2n/(r-l) and P[2][0] = (r+l)/(r-l), which rearranges to
+		// these. atan then gives the angles.
+		float tanRight = ( 1.0f + proj.columns[2][0]) / proj.columns[0][0];
+		float tanLeft  = (-1.0f + proj.columns[2][0]) / proj.columns[0][0];
+		float tanUp    = ( 1.0f + proj.columns[2][1]) / proj.columns[1][1];
+		float tanDown  = (-1.0f + proj.columns[2][1]) / proj.columns[1][1];
+
+		simd_float4 pos = worldFromView.columns[3];
+		simd_quatf q = simd_quaternion(worldFromView);
+
+		lua_createtable(L, 0, 4);
+
+		lua_createtable(L, 0, 2);
+		{
+			lua_createtable(L, 3, 0);
+			lua_pushnumber(L, pos.x); lua_rawseti(L, -2, 1);
+			lua_pushnumber(L, pos.y); lua_rawseti(L, -2, 2);
+			lua_pushnumber(L, pos.z); lua_rawseti(L, -2, 3);
+			lua_setfield(L, -2, "pos");
+
+			lua_createtable(L, 4, 0);
+			lua_pushnumber(L, q.vector.x); lua_rawseti(L, -2, 1);
+			lua_pushnumber(L, q.vector.y); lua_rawseti(L, -2, 2);
+			lua_pushnumber(L, q.vector.z); lua_rawseti(L, -2, 3);
+			lua_pushnumber(L, q.vector.w); lua_rawseti(L, -2, 4);
+			lua_setfield(L, -2, "quat");
+		}
+		lua_setfield(L, -2, "pose");
+
+		lua_createtable(L, 0, 4);
+		lua_pushnumber(L, atanf(tanLeft));  lua_setfield(L, -2, "angleLeft");
+		lua_pushnumber(L, atanf(tanRight)); lua_setfield(L, -2, "angleRight");
+		lua_pushnumber(L, atanf(tanUp));    lua_setfield(L, -2, "angleUp");
+		lua_pushnumber(L, atanf(tanDown));  lua_setfield(L, -2, "angleDown");
+		lua_setfield(L, -2, "fov");
+
+		id<MTLTexture> tex = cp_drawable_get_color_texture(g_drawable, i);
+		lua_pushinteger(L, (lua_Integer) tex.width);  lua_setfield(L, -2, "w");
+		lua_pushinteger(L, (lua_Integer) tex.height); lua_setfield(L, -2, "h");
+
+		lua_rawseti(L, -2, (int) i + 1);
+	}
+
+	return 1;
+}
+
+/**
+ * The drawable's colour texture for one eye, as a love Texture that can be set
+ * as a render target. Zero copies: the renderer draws where the compositor
+ * will read.
+ */
+static int w_eyeCanvas(lua_State *L)
+{
+	int index = (int) luaL_checkinteger(L, 1) - 1;
+	if (g_drawable == nullptr || index < 0)
+		return 0;
+
+	if ((size_t) index >= cp_drawable_get_texture_count(g_drawable))
+		return 0;
+
+	id<MTLTexture> mtl = cp_drawable_get_color_texture(g_drawable, index);
+	if (mtl == nil)
+		return 0;
+
+	void *key = (__bridge void *) mtl;
+	auto it = g_eyeTextures.find(key);
+	if (it == g_eyeTextures.end())
+	{
+		auto gfx = getMetalGraphics();
+		if (gfx == nullptr)
+			return 0;
+
+		love::graphics::Texture *t = nullptr;
+		luax_catchexcept(L, [&]() { t = gfx->newTextureFromHandle(key); });
+		if (t == nullptr)
+			return 0;
+
+		g_eyeTextures[key] = t;
+		it = g_eyeTextures.find(key);
+	}
+
+	luax_pushtype(L, it->second);
+	return 1;
+}
+
+static int w_submitFrame(lua_State *L)
+{
+	if (g_frame == nullptr || g_drawable == nullptr)
+		return 0;
+
+	auto gfx = getMetalGraphics();
+	if (gfx != nullptr)
+		gfx->flushBatchedDraws();
+
+	// The compositor needs a command buffer of its own to schedule the
+	// present against; LOVE's is already committed by the time we get here.
+	// Device and queue are made ONCE: they were being allocated per frame,
+	// which is ninety command queues a second for one command buffer each.
+	static id<MTLDevice> device = nil;
+	static id<MTLCommandQueue> queue = nil;
+	if (queue == nil)
+	{
+		device = MTLCreateSystemDefaultDevice();
+		queue = [device newCommandQueue];
+	}
+	id<MTLCommandBuffer> cmd = [queue commandBuffer];
+
+	// DEPTH, which this path had never written at all.
+	//
+	// CompositorServices reprojects every submitted frame against the
+	// drawable's depth texture -- that is how a frame rendered for one head
+	// pose is shown correctly at the pose it actually arrives at. Nothing here
+	// ever touched it, so it reprojected against whatever was left in that
+	// memory: the picture survived in a small, oddly shaped island with stray
+	// tiles around its edges, different in each eye, while everything INSIDE
+	// the island looked perfectly correct. Which is exactly how it was
+	// described, and is why the shape never matched anything in the renderer.
+	//
+	// Cleared to 0, the far value under the reverse-Z convention the
+	// compositor uses, so the whole frame reprojects as distant geometry --
+	// the same thing the host's own renderer does for its panel. Writing real
+	// per-pixel depth would reproject better still, but that means handing the
+	// scene's depth buffer across, and a defined far plane is the difference
+	// between a correct frame and this.
+	size_t depthCount = cp_drawable_get_texture_count(g_drawable);
+	for (size_t i = 0; i < depthCount; i++)
+	{
+		id<MTLTexture> depth = cp_drawable_get_depth_texture(g_drawable, i);
+		if (depth == nil)
+			continue;
+		MTLRenderPassDescriptor *pass = [MTLRenderPassDescriptor renderPassDescriptor];
+		pass.depthAttachment.texture = depth;
+		pass.depthAttachment.loadAction = MTLLoadActionClear;
+		pass.depthAttachment.storeAction = MTLStoreActionStore;
+		pass.depthAttachment.clearDepth = 0.0;
+		id<MTLRenderCommandEncoder> enc =
+			[cmd renderCommandEncoderWithDescriptor:pass];
+		[enc endEncoding];
+	}
+
+	cp_drawable_encode_present(g_drawable, cmd);
+	[cmd commit];
+
+	cp_frame_end_submission(g_frame);
+
+	g_frame = nullptr;
+	g_drawable = nullptr;
+
+	luax_pushboolean(L, true);
+	return 1;
+}
+
+static const luaL_Reg functions[] =
+{
+	{ "available",   w_available   },
+	{ "supported",   w_supported   },
+	{ "claim",       w_claim       },
+	{ "release",     w_release     },
+	{ "state",       w_state       },
+	{ "beginFrame",  w_beginFrame  },
+	{ "views",       w_views       },
+	{ "eyeCanvas",   w_eyeCanvas   },
+	{ "submitFrame", w_submitFrame },
+	{ 0, 0 }
+};
+
+extern "C" int luaopen_love_xr(lua_State *L)
+{
+	lua_newtable(L);
+	luax_register(L, nullptr, functions);
+	return 1;
+}
