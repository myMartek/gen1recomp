+// which is what makes the graphics backend render into an offscreen texture
+// instead of looking for a layer to present to.
+extern "C" int love_visionos_boot()
+{
+	static char arg0[] = "love";
+	char *argv[] = { arg0, nullptr };
+
+	int retval = 0;
+	DoneAction done = DONE_QUIT;
+	love::Variant restartvalue;
+
+	do
+	{
+		done = runlove(1, argv, retval, restartvalue);
+		done = DONE_RESTART;
+	} while (done != DONE_QUIT);
+
+	return retval;
