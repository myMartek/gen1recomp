@@ -302,6 +308,50 @@ static DoneAction runlove(int argc, char **argv, int &retval, love::Variant &res
 	return done;
 }
 
+#ifdef LOVE_VISIONOS
+// Must be called on the MAIN thread before love_visionos_boot() runs anywhere
+// else. SDL's video init reaches into UIKit (-[UIApplication
+// _setIdleTimerDisabled:] by way of UIKit_SuspendScreenSaver), and BoardServices
+// asserts a main-run-loop barrier there -- doing it from LOVE's own thread
+// traps. Bringing the subsystem up here first leaves LOVE's later
+// SDL_InitSubSystem as a refcount bump that touches nothing.
+extern "C" void love_visionos_prepareOnMainThread()
+{
+	SDL_SetMainReady();
+	SDL_InitSubSystem(SDL_INIT_VIDEO | SDL_INIT_EVENTS);
+}
+
+// Entry point for the visionOS shell, which owns @main itself (SwiftUI) and
+// so cannot use the one below. Runs LOVE on whatever thread it is called
+// from and does not return: like iOS, visionOS apps are never meant to exit
+// programmatically, so a quit is turned back into a restart.
+//
+// The caller is expected to have set love_visionos_setHeadless(true) first,
+// which is what makes the graphics backend render into an offscreen texture
+// instead of looking for a layer to present to.
+extern "C" int love_visionos_boot()
+{
+	static char arg0[] = "love";
+	char *argv[] = { arg0, nullptr };
+
+	int retval = 0;
+	DoneAction done = DONE_QUIT;
+	love::Variant restartvalue;
+
+	do
+	{
+		done = runlove(1, argv, retval, restartvalue);
+		done = DONE_RESTART;
+	} while (done != DONE_QUIT);
+
+	return retval;
+}
+#endif
+
+// LOVE_NO_MAIN lets a target compile this file for love_visionos_boot() while
+// providing its own entry point -- the SwiftUI shell's @main, which would
+// otherwise collide with this at link time.
+#ifndef LOVE_NO_MAIN
 int main(int argc, char **argv)
 {
 	if (strcmp(LOVE_VERSION_STRING, love_version()) != 0)
@@ -333,5 +383,6 @@ int main(int argc, char **argv)
 
 	return retval;
 }
+#endif // LOVE_NO_MAIN
 
 #endif // LOVE_BUILD_EXE
