<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
	Info.plist for the fully immersive visionOS build.

	Derived from mobile/ios/overlays/love-ios.plist. Dropped relative to it:
	interface orientations, every status-bar key, UILaunchStoryboardName and
	LSRequiresIPhoneOS (all iOS-family concepts with no visionOS meaning), and
	the HealthKit usage string (there is no HealthKit here, so the Pokéwalker
	mod simply does not apply).

	The scene-manifest keys below are taken verbatim from Xcode 27's own
	visionOS App template (primarySceneType Window / secondarySceneType Metal /
	immersiveSpaceStyle Full), not from documentation -- the naming is easy to
	get subtly wrong and a wrong key fails silently by just never opening the
	space.
-->
<plist version="1.0">
<dict>
	<key>CFBundleDevelopmentRegion</key>
	<string>en</string>
	<key>CFBundleDisplayName</key>
	<string>Gen1 Vision</string>
	<key>CFBundleExecutable</key>
	<string>${EXECUTABLE_NAME}</string>
	<key>CFBundleIdentifier</key>
	<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>CFBundleName</key>
	<string>${PRODUCT_NAME}</string>
	<key>CFBundlePackageType</key>
	<string>APPL</string>
	<key>CFBundleShortVersionString</key>
	<string>$(MARKETING_VERSION)</string>
	<key>CFBundleVersion</key>
	<string>$(CURRENT_PROJECT_VERSION)</string>

	<!-- Export compliance, answered here instead of by hand on every upload.
	     Without it App Store Connect holds each build and asks the same
	     question in the browser before it can go to a tester.

	     False is the accurate answer: this app implements no encryption of its
	     own and calls none. It has no accounts, no server, nothing to protect
	     in transit -- the cartridge the player supplies is read, decoded and
	     kept on the device, and never leaves it. -->
	<key>ITSAppUsesNonExemptEncryption</key>
	<false/>

	<!-- The launcher window is the default scene rather than the immersive
	     space. That is deliberate: the ROM importer needs somewhere to present
	     a file picker, and an app that launches straight into an ImmersiveSpace
	     has no such place. The player opens the space from the launcher. -->
	<key>UIApplicationSceneManifest</key>
	<dict>
		<key>UIApplicationSupportsMultipleScenes</key>
		<true/>
		<key>UIApplicationPreferredDefaultSceneSessionRole</key>
		<string>UIWindowSceneSessionRoleApplication</string>
		<key>UISceneConfigurations</key>
		<dict>
			<key>UISceneSessionRoleImmersiveSpaceApplication</key>
			<array>
				<dict>
					<key>UISceneInitialImmersionStyle</key>
					<string>UIImmersionStyleFull</string>
				</dict>
			</array>
		</dict>
	</dict>

	<!-- ExtendedGamepad covers the DualSense (GCDualSenseGamepad conforms to
	     GCExtendedGamepad).

	     SpatialGamepad is what makes the PSVR2 Sense pair reachable at all.
	     A single Sense controller cannot offer a whole gamepad profile, and
	     GameController only enumerates devices that can -- so without this
	     entry the pair arrives as ONE coalesced MFi gamepad that ARKit cannot
	     track. Declared, the two also appear separately, as GCSpatialAccessory
	     (visionOS 27) or with productCategory GCProductCategorySpatialController,
	     which is what ar_accessory_load_from_device needs.

	     Both stay listed: the coalesced gamepad is what SDL enumerates and
	     what drives the buttons and the sticks. Only the 6DoF poses come from
	     ARKit's accessory tracking. -->
	<!--
		True, as in the build where the controller actually drove the game.
		Setting it false was an attempt to stop SwiftUI's focus ring competing
		for the pad; it did not help, and the configuration that worked had
		this on and no window open during immersion. Restored together with
		that window behaviour, since the two go together.
	-->
	<key>GCSupportsControllerUserInteraction</key>
	<true/>
	<key>GCSupportedGameControllers</key>
	<array>
		<dict>
			<key>ProfileName</key>
			<string>ExtendedGamepad</string>
		</dict>
		<dict>
			<key>ProfileName</key>
			<string>SpatialGamepad</string>
		</dict>
	</array>

	<!-- ARKit providers. World sensing backs the device anchor that every eye
	     pose is derived from; accessory tracking is the PSVR2 Sense grip/aim
	     poses; hand tracking is the fallback when no controller is present.
	     visionOS shows one consolidated sheet, so do not add keys for
	     providers we never start. -->
	<key>NSWorldSensingUsageDescription</key>
	<string>Anchors the Kanto overworld in the room around you so it stays put as you move.</string>
	<key>NSAccessoryTrackingUsageDescription</key>
	<string>Tracks your PlayStation VR2 Sense controllers so your Pokédex and your aim follow your hands.</string>
	<key>NSHandsTrackingUsageDescription</key>
	<string>Lets you hold the Pokédex and point at the world with your hands when no controller is connected.</string>

	<!-- Exposes the app's Documents folder so ROMs, mod .zips and .sav files
	     can be dropped in; GRBootstrap sweeps them into the LÖVE save dir.
	     Note there is no Finder-over-USB path to a Vision Pro, so in practice
	     these are reached with `devicectl device copy to` -- but the keys are
	     what make the swept file visible in the first place. -->
	<key>UIFileSharingEnabled</key>
	<true/>
	<key>LSSupportsOpeningDocumentsInPlace</key>
	<true/>

	<key>CFBundleDocumentTypes</key>
	<array>
		<dict>
			<key>CFBundleTypeName</key>
			<string>LÖVE Project</string>
			<key>CFBundleTypeRole</key>
			<string>Viewer</string>
			<key>LSHandlerRank</key>
			<string>Owner</string>
			<key>LSItemContentTypes</key>
			<array>
				<string>org.love2d.love-game</string>
			</array>
		</dict>
	</array>
	<key>UTExportedTypeDeclarations</key>
	<array>
		<dict>
			<key>UTTypeConformsTo</key>
			<array>
				<string>com.pkware.zip-archive</string>
			</array>
			<key>UTTypeDescription</key>
			<string>LÖVE Project</string>
			<key>UTTypeIdentifier</key>
			<string>org.love2d.love-game</string>
			<key>UTTypeTagSpecification</key>
			<dict>
				<key>com.apple.ostype</key>
				<string>LOVE</string>
				<key>public.filename-extension</key>
				<array>
					<string>love</string>
				</array>
				<key>public.mime-type</key>
				<string>application/x-love-game</string>
			</dict>
		</dict>
	</array>
</dict>
</plist>
