<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
	Intentionally near-empty, and worth saying why rather than leaving it
	looking unfinished.

	World, hand and accessory tracking on visionOS are gated by the
	NS*UsageDescription strings in Info.plist plus runtime ar_*_provider
	authorization -- not by entitlements. HealthKit (the one entitlement the
	iOS build carries, for the Pokéwalker mod) does not exist here.

	The file still exists so CODE_SIGN_ENTITLEMENTS has a stable target and
	adding a real entitlement later is a one-line change rather than a
	project-settings change.
-->
<plist version="1.0">
<dict>
	<key>com.apple.developer.arkit.main-camera-access.allow</key>
	<false/>
</dict>
</plist>
